struct Holder {
    first: struct {},
    second: struct {}
}

fn make_marker() -> struct {} {
    return .{};
}

fn accept(_: struct {}) -> i32 {
    return 1;
}

fn observe(_: &struct {}) -> i32 {
    return 2;
}

fn main() -> i32 {
    let marker: struct {} = .{};
    let holder: Holder = .{ first = .{}, second = make_marker() };
    let values = [2]struct {}{.{}, .{}};

    if accept(marker) + observe(&holder.first) + observe(&values[1]) != 5 {
        return 1;
    }
    return 0;
}
