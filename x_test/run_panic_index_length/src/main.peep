// The length of an element is known at compile time, but its index, here
// the array's length, is still checked, as in Rust.
fn pick() -> i32 { return 2; }

fn main() {
    let grid = [2][3]i32{[3]i32{1, 2, 3}, [3]i32{4, 5, 6}};
    println("inside: ", grid[1].len);
    println(grid[pick()].len);
}
