enum Choice {
    Left: struct { value: i32 },
    Right: struct { value: i32 },
}

struct Holder {
    choice: Choice,
}

fn Clear(holder: &mut Holder) {
    holder.choice = Choice::Right with .{ value = 0 };
}

fn Read(mut holder: Holder) -> i32 {
    if &holder.choice is Choice::Left {
        Clear(&mut holder);
        return choice.value;
    }
    return 0;
}
