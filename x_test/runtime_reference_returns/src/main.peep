struct Box {
    value: i32
}

fn Identity(value: &Box) -> &Box from value {
    return value;
}

fn Choose(cond: bool, left: &Box, right: &Box) -> &Box from(left, right) {
    if cond {
        return left;
    }
    return right;
}

fn Recursive(value: &Box, done: bool) -> &Box from value {
    if done {
        return value;
    }
    return Recursive(value, true);
}

fn (self: &Box) Reference() -> &Box from self {
    return self;
}

fn main() -> i32 {
    let left: Box = .{ value = 11 };
    let right: Box = .{ value = 22 };
    let selected = Choose(false, &left, &right);
    let recursive = Recursive(selected, false);
    let method = left.Reference();
    let identity = Identity(method);
    if recursive.value == 22 && identity.value == 11 {
        return 0;
    }
    return 1;
}
