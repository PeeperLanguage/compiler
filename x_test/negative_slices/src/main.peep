// What slices cannot do yet, or ever: cross to C, be written through `&[]`,
// become writable from `&[]`, change element type.

#[extern("takes")]
fn takes(values: &[]i32);

fn first(view: &[]i32) -> i32 {
    view[0] = 1;
    view = view;
    view.len = 2;
    let of_slice = &mut (view.len);
    let negative = view[-1];
    let wide = view[-1i128];
    let past = view[18446744073709551616u128];
    return view.length;
}

fn edit(values: &mut []i32) {}
fn wide(values: &[]i64) {}

fn main() {
    let fixed = [3]i32{1, 2, 3};
    let view: &[]i32 = &fixed;
    edit(view);
    edit(&mut fixed);
    wide(&fixed);
}
