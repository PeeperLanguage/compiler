// A debug build gives every source variable a stack slot and a debug record
// when its type can be described. Variables of other types (struct, str,
// optional, array) build and run the same, without a record.

struct Point {
    x: i32,
    y: i32
}

fn Read(_: &i64, point: &Point) -> i32 {
    return point.x;
}

fn main() -> i32 {
    let mut count: i64 = 30;
    count = count + 2;
    let point = Point.{ x = 4, y = 6 };
    let ratio: f64 = 2.5;
    let ready = true;
    let letter: byte = 65;
    let text: str = "abc";
    let maybe: ?i32 = 4;
    let items = [2]i32{1, 2};
    let mut total: i32 = Read(&count, &point);
    for value in items {
        total = total + value;
    }
    if maybe == none {
        return 0;
    }
    if ready && ratio > 2.0 && letter == 65 && text == "abc" {
        return total + point.y + 33 - maybe;
    }
    return 0;
}
