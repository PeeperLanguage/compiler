enum Shape { Round: struct { radius: i32 }, Empty }
fn Make() -> Shape { return Shape::Empty; }

struct Holder { shape: Shape }

// The payload name borrows the subject until its last use.
fn ChangeWhileNamed(mut holder: Holder) {
    match &mut holder.shape {
        Shape::Round => {
            holder.shape = Shape::Empty;
            shape.radius = 2;
        }
        _ => { }
    }
}

fn MutableOfImmutable(shape: Shape) {
    let s = shape;
    match &mut s {
        Shape::Round => { s.radius = 1; }
        _ => { }
    }
}

fn Temporary() {
    match &Make() {
        Shape::Round => { }
        _ => { }
    }
}
