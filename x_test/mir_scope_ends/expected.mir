fn walk:
  bb0:
    store limit.0, arg0
    store total.1, 0
    %2 = load limit.0: i32
    %3 = LessOrEqual 0, %2: bool
    branch %3 (0..limit) bb1 bb2
  bb1:
    %4 = Subtract %2, 0: i32
    %5 = convert %4: u32
    goto bb3
  bb2:
    %6 = Subtract 0, %2: i32
    %7 = convert %6: u32
    goto bb3
  bb3:
    %8 = phi bb1: %5, bb2: %7: u32
    %9 = phi bb1: 1, bb2: 4294967295: i32
    %10 = NotEqualTo %8, 0: bool
