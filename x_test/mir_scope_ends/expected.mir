    scope end early.5
    scope end doubled.4
    scope end value.3
    scope end i.2
    goto bb6
  bb9:
    %33 = load doubled.4: i32
    %34 = EqualTo %33, 2: bool
    branch %34 (doubled == 2) bb11 bb12
  bb10:
    scope end early.5
    goto bb9
  bb11:
    scope end doubled.4
    scope end value.3
    scope end i.2
    goto bb7
  bb12:
    %38 = load total.1: i32
