  bb4:
    %11 = phi bb3: 0, bb7: %18: i32
    %12 = phi bb3: %8, bb7: %19: u32
    %13 = phi bb3: 0, bb7: %20: u64
    %14 = phi bb3: %10, bb7: %17: bool
