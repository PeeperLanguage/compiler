  bb5:
    store i.2, %13
    store value.3, %11
    %17 = GreaterThan %12, 1: bool
    %18 = Add %11, %9: i32
    %19 = Subtract %12, 1: u32
    %20 = Add %13, 1: u64
    %21 = load value.3: i32
    %22 = Multiply %21, 2: i32
    store doubled.4, %22
    %24 = load doubled.4: i32
    %25 = GreaterThan %24, 6: bool
