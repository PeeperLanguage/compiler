    store total.1, %40
    scope end doubled.4
    scope end value.3
    scope end i.2
    goto bb7
  bb13:
    goto bb12
  bb14:
    %45 = load total.1: i32
    %46 = LessThan %45, 100: bool
    branch %46 (total < 100) bb16 bb15
  bb15:
    %63 = load total.1: i32
    scope end total.1
    scope end limit.0
    return %63
  bb16:
    store step.6, 10
    %48 = load total.1: i32
    %49 = GreaterThan %48, 50: bool
    branch %49 (total > 50) bb17 bb18
  bb17:
    %50 = load step.6: i32
    store late.7, %50
    %52 = load late.7: i32
    scope end late.7
    scope end step.6
    scope end total.1
    scope end limit.0
    return %52
  bb18:
    %58 = load total.1: i32
    %59 = load step.6: i32
    %60 = Add %58, %59: i32
    store total.1, %60
    scope end step.6
    goto bb14
  bb19:
    scope end late.7
    goto bb18
  bb20:
    scope end total.1
    scope end limit.0
    fall off at `}`
