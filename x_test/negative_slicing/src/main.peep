// What `&a[i..j]` rejects: ends known at compile time outside the array or
// out of order, a step, slicing without `&`, a range value, ends that are
// not integers, slicing through a raw pointer, a writable
// slice through `&` or of a `[&]`, ends outside every slice, `.*` on a
// slice, two writable slices of one array at once, a slice's array used
// while a slice of it is, and a slice of a local or of an array parameter
// returned.
fn bounds(x: f64, y: f64) {
    let mut a = [4]i32{1, 2, 3, 4};
    let past = &a[0..5];
    let inclusive_past = &a[1..=4];
    let negative = &a[-1i32..2];
    let start_past = &a[5..];
    let no_end = &a[1..=]; // only the parser's error, not "outside" too
    let wide = &a[..18446744073709551616u128];
    let backwards = &a[3..1];
    let inclusive_backwards = &a[3..=1];
    let stepped = &a[0..4:2];
    let bare = a[1..3];
    let r = 0..2;
    let by_value = &a[r];
    let floats = &a[x..y];
}

fn through(r: &[4]i32, s: [&]i32, p: *[4]i32) {
    let writable = &mut r[0..2];
    let writable_slice = &mut s[0..1];
    let negative_end = &s[-1i32..];
    let past_usize = &s[..18446744073709551616u128];
    let slice_backwards = &s[2..1];
    let elements = &s.*;
    let raw = &p[0..2];
}

fn both_writable() {
    let mut a = [4]i32{1, 2, 3, 4};
    let left = &mut a[0..2];
    let right = &mut a[2..4];
    left[0] = right[0];
}

fn slice_loans(s: [&mut]i32) {
    let view = &s[0..2];
    s[0] = 1;
    let read = view[0];
    let part = &mut s[1..];
    let first = s[0];
    part[0] = first;
}

fn escape(view: [&]i32) -> [&]i32 {
    let a = [2]i32{1, 2};
    return &a[0..1];
}

// The parameter is the caller's copy, gone once the function returns.
fn from_parameter(values: [3]i32, view: [&]i32) -> [&]i32 {
    return &values[0..1];
}

fn main() {}
