// The MIR of `for` over an array: the array is stored once in a hidden
// variable, then a counted loop reads one element each pass. The hidden
// variables print as `_`; only `i`, `value` and `total` have names.
fn sum(values: &[3]i32) -> i32 {
    let mut total = 0;
    for value in values {
        total = total + value.*;
    }
    return total;
}

fn indexed(values: [2]i32) -> usize {
    let mut total: usize = 0;
    for i, value in values {
        total = total + i;
    }
    return total;
}

fn main() {}
