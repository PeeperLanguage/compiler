    %15 = load total.1: u64
    %16 = load i.3: u64
    %17 = Add %15, %16: u64
    store total.1, %17
    scope end value.4
    scope end i.3
    goto bb4
  bb3:
    scope end _.2
    %22 = load total.1: u64
