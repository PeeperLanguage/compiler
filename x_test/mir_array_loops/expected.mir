fn sum:
  bb0:
    store values.0, arg0
    store total.1, 0
    %2 = load values.0: &[3]i32
    store _.2, %2
    %4 = NotEqualTo 3, 0: bool
    goto bb1
  bb1:
    %5 = phi bb0: 0, bb4: %10: u64
    %6 = phi bb0: 3, bb4: %11: u64
    %7 = phi bb0: %4, bb4: %9: bool
    branch %7 (values) bb2 bb3
  bb2:
    store _.3, %5
    %9 = GreaterThan %6, 1: bool
    %10 = Add %5, 1: u64
    %11 = Subtract %6, 1: u64
    %12 = load _.3: u64
    %13 = borrow _.2.*[at %12]: &i32
    store value.4, %13
    %15 = load total.1: i32
    %16 = load value.4.*: i32
    %17 = Add %15, %16: i32
    store total.1, %17
    scope end value.4
    scope end _.3
    goto bb4
  bb3:
    scope end _.2
    %22 = load total.1: i32
    scope end total.1
    scope end values.0
    return %22
  bb4:
    goto bb1
  bb5:
    scope end total.1
    scope end values.0
    fall off at `}`
fn indexed:
  bb0:
    store values.0, arg0
