// A range is a value: it can be kept in a variable, passed, returned and
// held in a field, and it copies. A `for` or a spread over a range value
// counts it as one over the same range written in place, `..=` included,
// though whether it includes its end is known only when the program runs.
struct Span { values: range[u8], tag: i32 }

fn evens(n: i32) -> range[i32] {
    return 0..n:2;
}

fn total(r: range[i32]) -> i32 {
    let mut sum = 0;
    for v in r {
        sum = sum + v;
    }
    return sum;
}

fn passes(r: range[i32]) -> usize {
    let mut count: usize = 0;
    for i, v in r {
        count = i + 1;
    }
    return count;
}

fn fill(r: range[i32]) -> [4]i32 {
    return [4]i32{r...};
}

fn main() {
    let r = 1..=4;
    let copy = r;
    println("copied:", total(r), total(copy), total(r));
    println("evens:", total(evens(9)), passes(evens(9)), passes(evens(0)));
    println("ends:", total(0..3), total(0..=3), total(3..=0), total(5..0:2));
    println("passes:", passes(0..3), passes(0..=3), passes(3..=0), passes(5..0:2));
    let span = Span.{ values = 250..=255:2, tag = 7 };
    let mut last: u8 = 0;
    for v in span.values {
        last = v;
    }
    println("field:", last, span.tag);
    println("filled:", fill(0..4), fill(7..=4), fill(evens(8)));
    let down: range[i32] = 9..=0:3;
    println("spread:", [5]i32{100, down...});
}
