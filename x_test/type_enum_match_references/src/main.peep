enum SharedResource {
    Borrowed: struct { value: &i32 }
}

enum MutableResource {
    Borrowed: struct { value: &mut i32 }
}

enum RawResource {
    Pointer: struct { value: rawptr }
}

const global: i32 = 1;

fn Read(_: &i32) {}
fn Write(_: &mut i32) {}

fn Shared(source: &i32) {
    let resource = SharedResource::Borrowed with .{ value = source };
    match resource {
        SharedResource::Borrowed => {
            Read(resource.value);
        }
    }
    match resource {
        SharedResource::Borrowed => {
            Read(resource.value);
        }
    }
}

fn Mutable(source: &mut i32) {
    let resource = MutableResource::Borrowed with .{ value = source };
    match resource {
        MutableResource::Borrowed => {
            let .{ value } = resource;
            Write(value);
        }
    }
}

fn GlobalPointer() -> rawptr {
    let resource = RawResource::Pointer with .{ value = @global };
    match resource {
        RawResource::Pointer => {
            return resource.value;
        }
    }
}
