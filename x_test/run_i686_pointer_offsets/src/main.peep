// run_pointer_offsets on a 32-bit target, where an offset wraps at 32 bits.
import "core:allocator";

fn main() {
    let block = allocator::Allocate(64);
    let count: usize = 3;
    let mut at = block;
    for i in 0..count {
        let slot = at as *i32;
        slot.* = 10 + i as i32;
        at = at + 4;
    }
    let first = block as *i32;
    let third = (block + 8) as *i32;
    println(first.*, third.*, block + 0 == block, block + 4 == block);
    // An offset wraps at the pointer's 32 bits, back to `block`.
    println(block + 4294967295 + 1 == block);
    allocator::Free(block);
}
