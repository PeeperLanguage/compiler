#[extern("memset")]
fn Memset(destination: rawptr, value: i32, size: usize) -> rawptr;

fn Clear(value: rawptr) -> i32 {
    Memset(value, 0, 4);
    return 1;
}

fn main() -> i32 {
    let mut x: i32 = 10;
    if x + Clear(@x) != 11 || x != 0 { return 1; }

    x = 10;
    if x - Clear(@x) != 9 || x != 0 { return 2; }
    return 0;
}
