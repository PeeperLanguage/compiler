import "for_qualified_range_endpoints/values";

fn Read() -> i32 {
    for value in values::Zero..values::One {
        return value + 1;
    }
}

fn Sum(start: i32) -> i32 {
    let mut total: i32 = 0;
    for value in start..values::One {
        total = total + value + 1;
    }
    return total;
}

fn main() -> i32 {
    let mut total: i32 = Read();
    for index, value in values::Zero..values::One {
        total = total + index + value + 1;
    }
    {
        total = total + 1;
    }
    for value in values::Zero..values::Zero {
        total = total + 100;
    }
    for value in values::One..values::Zero {
        total = total + 100;
    }
    return total + Sum(values::Zero) + Sum(values::One) + Sum(2);
}
