struct Buffer {
    value: i32
}

/// distroys everything
/// and
/// does nothing
// doc comments needs to snap on to the next decl node, should merge all previous doc comments lines even if have gaps
fn destroy(_: Buffer) {}

fn main() -> i32 {
    let mut current: Buffer = .{ value = 1 };
    let mut next = current;
    next.value = 2;
    //let another = current;

    if next.value == 2 {
        return 69;
    }

    destroy(next);

    return 0;
}
