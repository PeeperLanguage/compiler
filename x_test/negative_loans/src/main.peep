// Each access a reference still in use forbids: one error per function.
struct Pair { left: i32, right: i32 }

fn read(n: &i32) -> i32 {
    return n.*;
}

fn both(a: &mut i32, b: &i32) {}

fn twice(a: &mut i32, b: &mut i32) {}

fn take(n: &mut i32, flag: bool) {}

fn bump(n: &mut i32) -> i32 {
    return 1;
}

fn consume(a: &mut Pair, b: Pair) {}

fn WriteUnderShared() -> i32 {
    let mut x = 1;
    let r = &x;
    x = 2;
    return read(r);
}

fn MoveUnderShared() -> i32 {
    let p = Pair.{ left = 1, right = 2 };
    let r = &p;
    let moved = p;
    return r.left;
}

fn MutableUnderShared() -> i32 {
    let mut x = 1;
    let r = &x;
    let m = &mut x;
    return read(r);
}

fn ReadUnderMutable() -> i32 {
    let mut x = 1;
    let m = &mut x;
    let copy = x;
    m.* = 2;
    return copy;
}

fn WriteUnderMutable() {
    let mut x = 1;
    let m = &mut x;
    x = 2;
    m.* = 3;
}

fn SharedUnderMutable() -> i32 {
    let mut x = 1;
    let m = &mut x;
    let r = &x;
    m.* = 2;
    return read(r);
}

// The same field, and the whole struct, overlap the borrowed field.
fn SameField() {
    let mut pair = Pair.{ left = 1, right = 2 };
    let left = &mut pair.left;
    pair.left = 3;
    left.* = 4;
}

// A borrow made on one side of an `if` is still in use after it.
fn BorrowInBranch(flag: bool) -> i32 {
    let a = 1;
    let mut x = 2;
    let mut r = &a;
    if flag {
        r = &x;
    }
    x = 3;
    return read(r);
}

// A reference made through `r` keeps `x` borrowed while it is in use.
fn ReborrowKeepsBorrow() {
    let mut x = 1;
    let r = &mut x;
    let s = &mut r.*;
    x = 2;
    s.* = 3;
}

// `x` ends with its block while `r` still refers to it.
fn OutlivesScope() -> i32 {
    let r: &i32;
    {
        let x = 1;
        r = &x;
    }
    return read(r);
}

// When the call starts, `&x`, passed to the same call, is still in use.
fn SameCall() {
    let mut x = 1;
    both(&mut x, &x);
}

fn SameCallTwice() {
    let mut x = 1;
    twice(&mut x, &mut x);
}

// The `&mut x` for `bump` takes hold while the one for `take` is reserved.
fn NestedMutable() {
    let mut x = 1;
    take(&mut x, bump(&mut x) > 0);
}

// `r` is still in use after the call, so `&mut x` cannot take hold.
fn SharedBeforeCall() -> i32 {
    let mut x = 1;
    let r = &x;
    take(&mut x, true);
    return read(r);
}

// Moving `p` while its `&mut` argument is reserved.
fn MovedArgument() {
    let mut p = Pair.{ left = 1, right = 2 };
    consume(&mut p, p);
}

// A `&mut` used as a `&` holds `m` like a `&`: no change through `m` while
// `r` is in use.
fn ChangedThroughMutable() -> i32 {
    let mut x = 1;
    let m = &mut x;
    let r: &i32 = m;
    m.* = 2;
    return read(r);
}
