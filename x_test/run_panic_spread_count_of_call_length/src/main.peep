// A range stepped by the length of a call's array spreads as many values
// as it holds, so a literal with room for fewer stops, not writes past it.
fn two() -> [2]i32 {
    return [2]i32{1, 2};
}

fn main() {
    println("before");
    let a = [3]usize{(0..10:two().len)...};
    println(a[0], a[1], a[2]);
}
