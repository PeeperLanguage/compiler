struct Holder { value: rawptr }
enum Resource { Pointer: struct { value: rawptr }, Empty }

const global: i32 = 1;

fn FromStruct(chooseLocal: bool) -> rawptr {
    let local: i32 = 2;
    let mut holder = Holder.{ value = @global };
    if chooseLocal {
        holder.value = @local;
    }
    return holder.value;
}

fn FromPayload() -> rawptr {
    let local: i32 = 2;
    let resource = Resource::Pointer with .{ value = @local };
    match resource {
        Resource::Pointer => {
            return resource.value;
        }
        Resource::Empty => {
            return @global;
        }
    }
}

fn Allowed() -> rawptr {
    let holder = Holder.{ value = @global };
    return holder.value;
}
