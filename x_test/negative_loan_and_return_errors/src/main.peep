// A loan broken and also returned: each mistake is its own error.
fn SameBlock(a: &i32) -> &i32 {
    let mut x = 1;
    let r = &x;
    x = 2;
    return r;
}

fn LaterBlock(a: &i32, c: bool) -> &i32 {
    let mut x = 1;
    let r = &x;
    x = 2;
    if c {
        return r;
    }
    return a;
}

// A local returned by reference ends at that `return`: one error, not
// "gone" as well.
fn ReturnsLocal(a: &i32) -> &i32 {
    let x = 1;
    return &x;
}

// The same when the local ends in an earlier block than the `return`.
fn EndsBeforeReturn(a: &i32, c: bool) -> &i32 {
    let r: &i32;
    {
        let x = 1;
        r = &x;
    }
    if c {
        return r;
    }
    return a;
}
