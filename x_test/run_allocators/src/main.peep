// `core:allocator`'s allocators, each through the same `&mut Allocator`.
import "core:allocator";

struct Node { value: i32, next: *Node }

// A list of up to `count` nodes, valued 1 and up, from `memory`, the last
// made first: as many as `memory` has room for.
fn List(memory: &mut allocator::Allocator, count: i32) -> *Node {
    let mut list: *Node = none;
    for i in 0..count {
        let node = memory.Allocate(size_of(Node), align_of(Node)) as *Node;
        if node == none {
            return list;
        }
        node.value = i + 1;
        node.next = list;
        list = node;
    }
    return list;
}

fn Sum(list: *Node) -> i32 {
    let mut sum: i32 = 0;
    let mut node = list;
    for node != none {
        sum = sum + node.value;
        node = node.next;
    }
    return sum;
}

fn Arena() {
    let mut arena = allocator::Arena::New(64);
    // A byte, then a pointer-aligned piece: it starts 8 bytes in.
    let byte = arena.Allocate(1, 1);
    let word = arena.Allocate(8, 8);
    println("arena:", word == byte + 8, arena.Allocate(1, 3) == none, arena.Allocate(1, 32) == none);
    // 64 bytes hold the two pieces and three of four nodes.
    println("arena list:", Sum(List(&mut arena, 4)));
    arena.Reset();
    println("arena reset:", arena.Allocate(1, 1) == byte, Sum(List(&mut arena, 4)));
    arena.Release();
    println("arena released:", arena.Allocate(1, 1) == none);
}

fn Pool() {
    let mut pool = allocator::Pool::New(16, 8, 3);
    let first = pool.Allocate(16, 8);
    let second = pool.Allocate(16, 8);
    println("pool:", second == first + 16, pool.Allocate(17, 8) == none, pool.Allocate(8, 16) == none);
    pool.Free(first);
    println("pool reuse:", pool.Allocate(16, 8) == first);
    // Freed, the three chunks hold three of five nodes.
    pool.Free(first);
    pool.Free(second);
    println("pool list:", Sum(List(&mut pool, 5)));
    pool.Release();
    let empty = allocator::Pool::New(16, 3, 3);
    println("pool of a wrong align:", empty.chunk);
    // Rounded up, a size near the top of `usize` would wrap to nothing.
    let zero: usize = 0;
    let mut huge = allocator::Pool::New(zero - 4, 8, 2);
    println("pool of a huge chunk:", huge.Allocate(0, 8) == none);
}

fn Stack() {
    let mut stack = allocator::Stack::New(256);
    let first = stack.Allocate(8, 8);
    let second = stack.Allocate(8, 8);
    stack.Free(second);
    println("stack:", stack.Allocate(8, 8) == second, second != first);
    // Each node takes 40 bytes with its mark: four more fit in 256.
    println("stack list:", Sum(List(&mut stack, 10)));
    stack.Release();
}

// Freeing a piece of a stack that is not the newest stops the program.
fn StackOrder() {
    let mut stack = allocator::Stack::New(64);
    let first = stack.Allocate(8, 8);
    let second = stack.Allocate(8, 8);
    println("freeing out of order");
    stack.Free(first);
}

fn main() {
    Arena();
    Pool();
    Stack();
    let mut heap = allocator::Heap.{};
    println("heap list:", Sum(List(&mut heap, 10)), heap.Allocate(8, 32) == none);
    StackOrder();
}
