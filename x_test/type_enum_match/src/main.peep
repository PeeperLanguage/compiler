enum Result {
    Ok: struct { value: i32, code: i32 },
    Error: struct { message: str },
    Pending
}

fn Read(result: Result) -> i32 {
    match result {
        Result::Ok => {
            return result.value;
        }
        Result::Error => {
            return 1;
        }
        Result::Pending => {
            return 0;
        }
    }
}
