enum Result {
    Ok: {
        value: i32,
    },
    Pending,
}

fn main() {
    let missing = Result::Ok with .{};
    let duplicate = Result::Ok with .{ value = 1, value = 2 };
    let unknown = Result::Ok with .{ item = 1 };
    let payloadless = Result::Pending with 1;
    let bare = Result::Ok;
    Result::Pending();
}
