// Where each temporary ends: with its statement; before the branch for an
// `if` or a loop condition, in each pass; with its side of `&&` there; and
// with the variable a `let` gives a value made with it, a side of `&&` too.

fn make() -> i32 {
    return 1;
}

fn look(value: &i32) -> bool {
    return value.* == 1;
}

fn main() {
    look(&make());
    let kept = &make();
    if look(&make()) {
        println(kept.*);
    }
    for look(&make()) {
        break;
    }
    if look(&make()) && look(&make()) {
        println(2);
    }
    let both = look(&make()) && look(&make());
}
