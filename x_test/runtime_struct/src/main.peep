struct Point {
    x: i32,
    y: i32
}

fn (self: &Point) sum() -> i32 {
    return self.x + self.y;
}

fn main() -> i32 {
    let p: Point = .Point{ x = 10, y = 20 };
    if p.sum() == 30 {
        let ok: cstr = c"struct ok\n";
        write(stdout, ok, 10);
        return p.x;
    }

    let bad: cstr = c"struct bad\n";
    write(stdout, bad, 11);
    return 1;
}
