// A `let` without a value is set by its first assignment, even without `mut`,
// as long as every path sets it once before it is used.

fn Sign(a: i32) -> i32 {
    let sign: i32;
    if a > 0 {
        sign = 1;
    } else if a < 0 {
        sign = -1;
    } else {
        sign = 0;
    }
    return sign;
}

fn SetThenUsed(a: i32) -> i32 {
    let doubled: i32;
    doubled = a * 2;
    return doubled;
}

fn EarlyReturn(a: i32) -> i32 {
    let value: i32;
    if a > 0 {
        return 0;
    } else {
        value = a;
    }
    return value;
}

fn Counter(a: i32) -> i32 {
    let mut count: i32;
    count = 0;
    if a > 0 {
        count = count + 1;
    }
    count = count + 1;
    return count;
}

fn NeverUsed(a: i32) {
    let unused: i32;
    if a > 0 {
        unused = 1;
    }
}
