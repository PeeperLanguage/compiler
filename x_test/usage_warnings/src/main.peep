import "usage_warnings/external";

struct unused_private_type {
    value: i32,
}

fn unused_private_func() -> i32 {
    let unused_local: i32 = 10;
    let _ignored_local: i32 = 20;
    return 0;
}

fn UnusedPublicFunction() -> i32 {
    return 100;
}

fn read_unmodified(mut value: i32) -> i32 {
    return value;
}

fn replace(mut value: i32) -> i32 {
    value = 42;
    return value;
}

fn keep_unreachable_mut() -> i32 {
    let mut value = 1;
    return value;
    value = 2;
}

fn main(unused_param: i32, _ignored_param: i32) -> i32 {
    let mut/* keep mut text */ unmodified = read_unmodified(1);
    let mut modified = 1;
    modified = replace(modified);
    let msg: cstr = c"Hello from Peeper runtime ABI!\n";
    write(stdout, msg, 30);
    return unmodified + modified + keep_unreachable_mut();
}
