enum Shape {
    Circle: struct { radius: i32 },
    Empty
}

enum Slot {
    Value: ?i32,
    Inner: Shape,
    Free
}

fn MissingNone(slot: Slot) -> i32 {
    match slot {
        Slot::Value with value => { return value; }
        Slot::Inner => { return 0; }
        Slot::Free => { return 0; }
    }
}

fn MissingInnerCase(slot: Slot) -> i32 {
    match slot {
        Slot::Value => { return 0; }
        Slot::Inner with Shape::Circle => { return slot.radius; }
        Slot::Free => { return 0; }
    }
}

fn TestedAfterWhole(slot: Slot) -> i32 {
    match slot {
        Slot::Value => { return 0; }
        Slot::Value with none => { return 0; }
        Slot::Inner => { return 0; }
        Slot::Free => { return 0; }
    }
}

fn WrongTests(slot: Slot) -> i32 {
    match slot {
        Slot::Inner with none => { return 0; }
        Slot::Free with none => { return 0; }
        Slot::Value with Shape::Empty => { return 0; }
    }
}

fn WrongNames(slot: Slot) -> i32 {
    match slot {
        Slot::Free with nothing => { return 0; }
        Slot::Inner with .{ radius } => { return radius; }
        _ => { return 0; }
    }
}

fn TooDeep(slot: Slot) -> i32 {
    match slot {
        Slot::Inner with Shape::Circle with none => { return 0; }
        _ => { return 0; }
    }
}

struct Holder { shape: Shape }

fn FieldsOfBorrowed(holder: &Holder) -> i32 {
    match &holder.shape {
        Shape::Circle with .{ radius } => { return radius; }
        Shape::Empty => { return 0; }
    }
}
