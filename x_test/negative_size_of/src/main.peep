iface Shape {
    fn Area(&self) -> i32,
}

struct Node {
    value: i32,
}

fn main() {
    let mut x: i32 = 1;
    let p = @x;
    size_of(str);
    size_of(cstr);
    size_of(Shape);
    size_of(x);
    size_of(1 + 2);
    size_of(Node, Node);
    align_of();
    size_of(main);
    size_of(Missing);
    let q = *Node;
    println(*p);
    let r = rawptr + 1;
    let s = [4]i32;
    *p = 5;
}

// A call of `size_of` is the built-in's, so no function takes the name.
fn size_of(x: i32) -> i32 {
    return x;
}
