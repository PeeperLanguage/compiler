// `.len` is an array's length, a `usize` its type gives: the array is not
// read, and is computed only for a call in it.
struct Holder {
    items: [4]i32,
}

fn make() -> [3]i32 {
    println("make runs");
    return [3]i32{1, 2, 3};
}

fn pick() -> i32 {
    println("pick runs");
    return 1;
}

fn total(values: &[5]i32) -> i32 {
    let mut sum = 0;
    for i in 0..values.len {
        sum = sum + values[i];
    }
    return sum;
}

fn main() {
    let mut values = [5]i32{1, 2, 3, 4, 5};
    const N = values.len;
    println("length:", values.len, N);
    let r = &values;
    let p = @values;
    println("through:", r.len, p.len);
    let grid = [2][3]i32{[3]i32{1, 2, 3}, [3]i32{4, 5, 6}};
    println("nested:", grid.len, grid[0].len);
    println("index call:", grid[pick()].len);
    println("call:", make().len);
    let h: Holder = .{items = [4]i32{0, 0, 0, 0}};
    println("field:", h.items.len);
    println("loop:", total(&values));
    let unset: [7]u8;
    println("unset:", unset.len);
    let empty = [0]i32{};
    println("empty:", empty.len);
}
