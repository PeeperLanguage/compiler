enum Shape { Circle: struct { radius: i32 }, Count: i32, Empty }

fn Find(id: i32) -> ?i32 { return none; }

// The payload is named only in the block the test guards.
fn OutsideBlock(shape: Shape) -> i32 {
    if shape is Shape::Count { }
    return shape + 1;
}

// The loop's next pass would read the payload of a value that may now be none.
fn AssignedInLoop(start: ?i32) -> i32 {
    let mut next = start;
    let mut total = 0;
    if next != none {
        for {
            total = total + next;
            next = Find(total);
        }
    }
    return total;
}

fn OrElsePlain(x: i32) -> i32 {
    let v = x orelse 0;
    return v;
}

fn OrElseStays(id: i32) -> i32 {
    let v = Find(id) orelse { println(1); };
    return 0;
}

fn OrElseWrongType(id: i32) -> i32 {
    let v = Find(id) orelse true;
    return v;
}
