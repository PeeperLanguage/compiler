enum Result {
    Ok: struct {
        value: i32,
    },
    Failed: str,
    Pending,
}

enum Code {
    Value: i32,
}

const SelectedCode: Code = Code::Value with 7;

fn Show(result: Result) {
    match result {
        Result::Ok => {
            println(result.value);
        }
        Result::Failed => {
            println(result);
        }
        Result::Pending => {
            println("pending");
        }
    }
}

fn ShowCode() {
    match SelectedCode {
        Code::Value => {
            println(SelectedCode);
        }
    }
}

fn main() -> i32 {
    Show(Result::Ok with .{ value = 42 });
    Show(Result::Failed with "404 not found");
    Show(Result::Pending);
    ShowCode();
    return 0;
}
