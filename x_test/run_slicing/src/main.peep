// `&a[i..j]` views the elements from `i` up to `j`, `..=` takes `j` too; a
// missing start is 0 and a missing end the length. Ends of any integer type
// known only when the program runs are checked then. A slice is sliced the
// same way, its ends always checked against its length when it runs.
fn total(view: [&]i32) -> i32 {
    let mut sum = 0;
    let mut i: usize = 0;
    for i < view.len {
        sum = sum + view[i];
        i = i + 1;
    }
    return sum;
}

fn fill(view: [&mut]i32, value: i32) {
    let mut i: usize = 0;
    for i < view.len {
        view[i] = value;
        i = i + 1;
    }
}

fn count(view: [&]i32) -> i32 {
    return view.len as i32;
}

fn update(view: [&mut]i32, value: i32) {
    view[0] = value;
}

fn main() {
    let mut a = [6]i32{1, 2, 3, 4, 5, 6};
    println("constant:", total(&a[1..3]), total(&a[1..=3]), total(&a[..2]), total(&a[4..]), total(&a[..]));
    let i: i32 = 2;
    let j: u8 = 5;
    let n: usize = 6;
    println("run time:", total(&a[i..]), total(&a[..j]), total(&a[i..=i]), total(&a[i..4]));
    println("empty:", count(&a[n..n]), count(&a[n..]), count(&a[3..=2]), count(&a[i..=i - 1]));
    let wide: u128 = 2;
    let long: i64 = 1;
    let narrow: i8 = 5;
    println("widths:", total(&a[wide..]), total(&a[long..=long]), total(&a[narrow..]));
    fill(&mut a[2..4], 0);
    update(&mut a[0..2], count(&a[1..4]));
    let r = &mut a;
    fill(&mut r[4..], 9);
    println("written:", a);
    let shared: [&]i32 = &mut a[1..];
    println("as shared:", count(&mut a[0..2]), shared.len);

    let mut b = [6]i32{1, 2, 3, 4, 5, 6};
    let all: [&]i32 = &b;
    let inner = &all[1..5];
    let deeper = &inner[1..];
    println("of slices:", total(inner), total(deeper), total(&deeper[..=0]), count(&inner[i..]), count(&inner[4..]), total(&all[wide..]));
    let mut rest: [&]i32 = &b;
    let mut steps = 0;
    for rest.len > 0 {
        rest = &rest[1..];
        steps = steps + 1;
    }
    let w: [&mut]i32 = &mut b;
    fill(&mut w[1..3], 0);
    update(&mut w[4..], 7);
    let view = &w[0..2];
    println("through slices:", steps, view[1] + w[3], w.len);
    let mut tail: [&mut]i32 = &mut b;
    tail = &mut tail[2..];
    tail[0] = 8;
    println("resliced:", b);
}
