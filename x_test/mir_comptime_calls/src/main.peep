// A constant's call runs while compiling: MIR holds only its value.
fn cube(n: i64) -> i64 {
    return n * n * n;
}

const BIG = cube(1000) + 1;

// A zero byte does not end the text a constant holds.
fn text() -> cstr {
    return c"ab\0cd";
}

const TEXT = text();

fn main() {
    println(BIG, TEXT);
}
