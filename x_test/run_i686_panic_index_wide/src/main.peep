// An index wider than a 32-bit `usize` is compared whole, before it is cut
// down: -4294967295 cut to 32 bits is 1, an element of `values`.
fn element(values: [3]i32, at: u64) -> i32 { return values[at]; }
fn viewed(view: [&]i32, at: i64) -> i32 { return view[at]; }

fn main() {
    let values = [3]i32{1, 2, 3};
    println("inside:", element(values, 2), viewed(&values, 1));
    println(viewed(&values, -4294967295));
}
