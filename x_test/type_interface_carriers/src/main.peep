iface Reader {
    fn (&Self) read() -> i32
}

iface Writer {
    fn (&mut Self) write(value: i32)
}

iface Consumer {
    fn (Self) take() -> i32
}

struct Counter {
    value: i32
}

fn (self: &Counter) read() -> i32 {
    return self.value;
}

fn (self: &mut Counter) write(value: i32) {
    self.value = value;
}

fn (self: Counter) take() -> i32 {
    return self.value;
}

#[extern("malloc")]
fn acquire_counter(size: usize) -> *Counter;

fn read(reader: &Reader) -> i32 {
    return reader.read();
}

fn write(writer: &mut Writer, value: i32) {
    writer.write(value);
}

fn main() -> i32 {
    let mut counter: Counter = .{ value = 1 };
    let reader: &Reader = &counter;
    if read(reader) != 1 {
        return 1;
    }
    write(&mut counter, 7);
    if read(&counter) != 7 {
        return 2;
    }

    let owned_counter = acquire_counter(4);
    owned_counter.value = 9;
    let owned_reader: *Reader = owned_counter;
    let owned_value = owned_reader.read();
    free(owned_reader);
    if owned_value != 9 {
        return 3;
    }

    let mut automatic_value = 0;
    {
        let automatic_counter = acquire_counter(4);
        automatic_counter.value = 13;
        let automatic_reader: *Reader = automatic_counter;
        automatic_value = automatic_reader.read();
    }

    let consumed_counter = acquire_counter(4);
    consumed_counter.value = 11;
    let consumer: *Consumer = consumed_counter;
    return automatic_value + consumer.take() - 24;
}
