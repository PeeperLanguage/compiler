enum Shape {
    Circle: struct { radius: i32 },
    Code: i32,
    Empty
}

fn NotLast(shape: Shape) -> i32 {
    match shape {
        _ => { return 0; }
        Shape::Circle => { return 1; }
    }
}

fn HandlesNothing(shape: Shape) -> i32 {
    match shape {
        Shape::Circle => { return 1; }
        Shape::Code => { return 2; }
        Shape::Empty => { return 3; }
        _ => { return 0; }
    }
}

fn StillMissing(shape: Shape) -> i32 {
    match shape {
        Shape::Circle => { return 1; }
        Shape::Code => { return 2; }
    }
}

// Two cases are left, so the subject is still the enum in the `_` arm.
fn NotNarrowed(shape: Shape) -> i32 {
    match shape {
        Shape::Empty => { return 0; }
        _ => { return shape.radius; }
    }
}
