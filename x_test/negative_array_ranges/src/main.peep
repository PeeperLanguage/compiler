// A spread range in an array literal needs the literal's (integer) element
// type, a non-zero step, and constant ends under `[_]`; the entries must
// give exactly `N` values.
fn count(n: i32) -> i32 {
    let unknown = [_]i32{(0..n)...};
    let over = [3]i32{(0..n)..., 1, 2, 3, 4, 5};
    let floats = [_]f64{(0..3)...};
    let exact = [3]i32{(0..5)...};
    let stopped = [_]i32{(0..5:0)...};
    let wide = [_]u8{(0..=256)...};
    let few = [2]i32{(0..2)..., 7};
    let flags = [_]bool{(0..2)...};
    let huge = [_]u64{(0..=18446744073709551615)...};
    let sum = [_]u64{(0..=9223372036854775807)..., (0..=9223372036854775807)...};
    return n;
}

fn main() {
    count(1);
}
