fn Make() -> []i32 {
    return []i32{1, 2};
}

fn MakeText() -> str {
    return "temporary";
}

fn Identity(value: &[]i32) -> &[]i32 from value {
    return value;
}

fn longest(a: &i32, b: &i32, c: &i32) -> &i32 from (a, b) {
    return a;
}

fn BindingEscape() {
    let reference = &Make();
}

fn StringBindingEscape() {
    let reference = &"temporary";
}

fn StringByteViewEscape() {
    let bytes = MakeText() |> as_bytes();
}

fn StringRangeEscape() {
    let range = MakeText()[0..1];
}

fn AssignmentEscape(seed: []i32) {
    let mut reference = &seed;
    reference = &Make();
}

fn ContractEscape() {
    let reference = Identity(&Make());
}

fn NestedContractEscape() {
    let reference = Identity(Identity(&Make()));
}

fn RawTemporaryAddress() {
    let pointer = @Make();
}
