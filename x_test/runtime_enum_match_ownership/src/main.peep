enum Resource {
    Owned: struct { selected: *i32, omitted: *i32 },
    Pending
}

fn Consume(resource: Resource) {
    match resource {
        Resource::Owned => {
            let .{ selected = selected, _ } = resource;
            free(selected);
            return;
        }
        Resource::Pending => {
            return;
        }
    }
}

// A state change returns the new value, so every path hands back a whole enum.
fn Reset(resource: Resource) -> Resource {
    match resource {
        Resource::Owned => {
            let .{ selected = selected, _ } = resource;
            free(selected);
            return Resource::Pending;
        }
        Resource::Pending => {
            return resource;
        }
    }
}

fn ResetAndConsume(mut resource: Resource) {
    resource = Reset(resource);
    Consume(resource);
}

fn main() -> i32 {
    let resource = Resource::Owned with .{
        selected = alloc(1),
        omitted = alloc(2),
    };
    ResetAndConsume(resource);
    Consume(Resource::Pending);
    return 0;
}
