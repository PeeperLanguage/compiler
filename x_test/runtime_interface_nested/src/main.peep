iface Summer {
    fn (&Self) sum() -> i32
}

struct Point {
    x: i32,
    y: i32
}

fn (self: &Point) sum() -> i32 {
    return self.x + self.y;
}

struct SummerHolder {
    value: *Summer
}

iface SummerConsumer {
    fn (&Self) consume(value: &Summer) -> i32
}

struct ConsumerImpl {}

fn (_: &ConsumerImpl) consume(value: &Summer) -> i32 {
    return value.sum();
}

#[extern("malloc")]
fn acquire_point(size: usize) -> *Point;

fn main() -> i32 {
    let first = acquire_point(8);
    first.x = 15;
    first.y = 25;
    let first_summer: *Summer = first;
    let mut holder: SummerHolder = .{ value = first_summer };

    let replacement = acquire_point(8);
    replacement.x = 15;
    replacement.y = 25;
    let replacement_summer: *Summer = replacement;
    holder.value = replacement_summer;

    let point: Point = .{ x = 15, y = 25 };
    let consumer_impl: ConsumerImpl = .{};
    let consumer: &SummerConsumer = &consumer_impl;
    let result = consumer.consume(&point);

    if result == 40 && holder.value.sum() == 40 {
        let ok: cstr = "nested interface ok\n";
        write(stdout, ok, 20);
        return 0;
    }

    let bad: cstr = "nested interface bad\n";
    write(stdout, bad, 21);
    return 1;
}
