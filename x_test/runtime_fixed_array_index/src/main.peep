struct Token {
    value: i32
}

struct Holder {
    tokens: [2]Token
}

fn choose() -> usize {
    return 1;
}

fn write(token: &mut Token, value: i32) {
    token.value = value;
}

fn main() -> i32 {
    let index = choose();
    let mut values = [_]i32{7, 9};
    if values[index] != 9 {
        return 1;
    }
    values[index] = 12;
    if values[1] != 12 {
        return 2;
    }

    let mut holder = .Holder{tokens = [_]Token{.{value = 3}, .{value = 5}}};
    write(&mut holder.tokens[index], 14);
    if holder.tokens[1].value != 14 {
        return 3;
    }
    return 0;
}
