struct Box { value: i32 }
enum Shape { Circle: struct { radius: i32 }, Count: i32, Empty }
enum Slot { Owned: *Box, Plain: i32, Free }

fn Find(id: i32) -> ?i32 {
    if id > 0 { return id * 2; }
    return none;
}

fn MakeBox(id: i32) -> ?*Box {
    if id > 0 { return alloc(Box.{ value = id }); }
    return none;
}

// Inside an arm, the subject's name is the payload of the arm's case.
fn Area(shape: Shape) -> i32 {
    match shape {
        Shape::Circle => { return shape.radius * 3; }
        Shape::Count => { return shape + 1; }
        Shape::Empty => { return 0; }
    }
}

fn Radius(shape: Shape) -> i32 {
    if shape is Shape::Circle {
        return shape.radius;
    } else if shape is Shape::Count {
        return shape;
    }
    return -1;
}

// The name reads the payload in place. Moving the payload out takes the whole
// slot, as it does for any value; the other arms leave it alone.
fn Take(slot: Slot) -> i32 {
    match slot {
        Slot::Owned => {
            let value = slot.value;
            free(slot);
            return value;
        }
        Slot::Plain => { return slot; }
        _ => { return -1; }
    }
}

// Reading a payload takes nothing: the slot is whole after each test.
fn Count(slot: Slot) -> i32 {
    let mut count = 0;
    if slot is Slot::Owned { count = count + slot.value; }
    match slot {
        Slot::Plain => { count = count + slot; }
        _ => { }
    }
    return count + Take(slot);
}

fn Fallback(id: i32) -> i32 {
    let v = Find(id) orelse 5;
    return v;
}

fn Leave(id: i32) -> i32 {
    let v = Find(id) orelse { return -9; };
    return v + 1;
}

fn LeaveOwned(id: i32) -> i32 {
    let box = MakeBox(id) orelse { return -1; };
    let value = box.value;
    free(box);
    return value;
}

fn Present(id: i32) -> i32 {
    let found = Find(id);
    if found != none {
        return found;
    } else {
        return 0;
    }
}

// After a guard that leaves, the name is the payload for the rest of the block.
fn Guard(id: i32) -> i32 {
    let found = Find(id);
    if found == none {
        return -1;
    }
    return found + 1;
}

// Assigning the name assigns the variable; reading it reads the payload.
fn Walk() -> i32 {
    let mut total = 0;
    let mut next = Find(3);
    for {
        if next == none { break; }
        total = total + next;
        next = Find(next / 2 - 1);
    }
    return total;
}

fn SumUntilNone() -> i32 {
    let mut total = 0;
    let mut id = 3;
    for {
        let v = Find(id) orelse { break; };
        total = total + v;
        id = id - 1;
    }
    return total;
}

fn main() -> i32 {
    if Area(Shape::Circle with .{ radius = 2 }) != 6 { return 1; }
    if Area(Shape::Count with 4) != 5 { return 2; }
    if Area(Shape::Empty) != 0 { return 3; }
    if Radius(Shape::Circle with .{ radius = 7 }) != 7 { return 4; }
    if Radius(Shape::Count with 8) != 8 { return 5; }
    if Radius(Shape::Empty) != -1 { return 6; }
    if Take(Slot::Owned with alloc(Box.{ value = 11 })) != 11 { return 7; }
    if Take(Slot::Plain with 3) != 3 { return 8; }
    if Take(Slot::Free) != -1 { return 9; }
    if Count(Slot::Owned with alloc(Box.{ value = 20 })) != 40 { return 10; }
    if Count(Slot::Plain with 3) != 6 { return 11; }
    if Fallback(4) != 8 { return 12; }
    if Fallback(-1) != 5 { return 13; }
    if Leave(2) != 5 { return 14; }
    if Leave(0) != -9 { return 15; }
    if LeaveOwned(6) != 6 { return 16; }
    if LeaveOwned(0) != -1 { return 17; }
    if Present(3) != 6 { return 18; }
    if Present(0) != 0 { return 19; }
    if Guard(3) != 7 { return 20; }
    if Guard(0) != -1 { return 21; }
    if Walk() != 12 { return 22; }
    if SumUntilNone() != 12 { return 23; }
    return 0;
}
