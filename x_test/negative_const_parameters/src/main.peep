// What a `const` parameter refuses.
fn Size(const T: type) -> usize {
    return size_of(T);
}

// `type` is only for a `const` parameter, which is one value.
fn Plain(t: type) {}
fn Changed(const mut n: i32) {}
fn Many(const n: ...i32) {}
fn Typed(const T: type, const value: T) {}

struct Point { x: i32 }
fn Scaled(const factor: i64, x: i64) -> i64 { return x * factor; }
fn Pointed(const p: Point) {}

// A C function is one function: it has no copies.
#[extern("abs")]
fn Abs(const T: type, x: i32) -> i32;

// A call through an interface reference runs one function of a table.
iface Shape {
    fn Area(&self, const T: type) -> i32
}
iface Named {
    fn Name(&self) -> i32
}
struct Box { x: i32 }
fn Box::Name(&self, const T: type) -> i32 { return 1; }

// A copy checks its body for its own type.
fn Double(const T: type, value: T) -> T {
    return value + value;
}

fn Value(const T: type) -> i32 {
    return T;
}

// Code after a written `return` is checked in a copy too.
fn Dead(const T: type) -> i32 {
    return 1;
    let wrong: i32 = true;
}

fn main() {
    println(Size());
    println(Size(5));
    println(Size(Missing));
    println(Size(i32, 1));
    let f = Size;
    let b = Box.{ x = 1 };
    let n: &Named = &b;
    println(Double(i32, 2), Double(bool, true));
    println(Value(i32));
    let x: i64 = 3;
    println(Scaled(x, 1));
    Pointed(Point.{ x = 1 });
    // A `const` parameter counts among the arguments.
    println(Scaled());
    println(Dead(u8));
}
