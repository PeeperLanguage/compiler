// A range with constant ends is counted while compiling: the array needs no
// length check, and each range fills its elements with a loop at a known offset.
fn known() -> [6]i32 {
    let arr = [_]i32{(0..3)..., 9, (5..=4)...};
    return arr;
}

fn main() {
    let arr = known();
    println(arr[0], arr[1], arr[2], arr[3], arr[4], arr[5]);
}
