enum Resource {
    Borrowed: struct { value: &i32 }
}

fn Read(_: &i32) {}

fn Invalid(mut source: i32) {
    let resource = Resource::Borrowed with .{ value = &source };
    let duplicate = resource;
    source = 2;
    match duplicate {
        Resource::Borrowed => {
            Read(duplicate.value);
        }
    }
}

fn InvalidSelfAssignment(mut source: i32) {
    let mut resource = Resource::Borrowed with .{ value = &source };
    resource = resource;
    match resource {
        Resource::Borrowed => {
            source = 2;
            Read(resource.value);
        }
    }
}
