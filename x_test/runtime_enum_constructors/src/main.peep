import "runtime_enum_constructors/result";

type LocalResult<T> = result::Alias<T>;

fn ReadImported(value: result::Alias<i32>) -> i32 {
    if !(value is result::Alias<i32>::Ok) {
        return 0;
    }
    match value {
        result::Alias<i32>::Ok with { value = payload } => {
            return payload;
        }
        result::Alias<i32>::Pending => {
            return 0;
        }
    }
}

fn main() -> i32 {
    let value = LocalResult<i32>::Ok with .{
        value = 42,
    };
    let _ = LocalResult<i32>::Pending;
    return ReadImported(value);
}
