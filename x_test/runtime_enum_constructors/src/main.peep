import "runtime_enum_constructors/result";

fn ReadImported(value: result::Result<i32>) -> i32 {
    if value is result::Result<i32>::Ok {
        return value.value;
    }
    return 0;
}

fn main() -> i32 {
    let value = result::Result<i32>::Ok{
        value = 42,
    };
    let _ = result::Result<i32>::Pending;
    return ReadImported(value);
}
