fn middle:
  bb0:
    store values.0, arg0
    store start.1, arg1
    %2 = load start.1: i32
    %3 = convert %2: u64
    %4 = GreaterThan %3, 4: bool
    check %4, "slice out of bounds"
    %6 = GreaterThan %3, 3: bool
    check %6, "slice starts after it ends"
    %8 = Subtract 3, %3: u64
    %9 = borrow values.0[from %3, count %8]: [&]i32
    store view.2, %9
    %11 = load view.2.*[at 0]: i32
    scope end view.2
    scope end start.1
    scope end values.0
    return %11
  bb1:
    scope end view.2
    scope end start.1
    scope end values.0
    fall off at `}`
fn main:
  bb0:
    fall off at `}`
fn tail:
  bb0:
    store view.0, arg0
    %1 = load view.0: [&]i32
    %2 = field %1[1]: u64
    %3 = GreaterThan 1, %2: bool
    check %3, "slice out of bounds"
    %5 = Subtract %2, 1: u64
    %6 = borrow view.0.*[from 1, count %5]: [&]i32
    store rest.1, %6
    %8 = load rest.1.*[at 0]: i32
    scope end rest.1
    scope end view.0
    return %8
  bb1:
    scope end rest.1
    scope end view.0
    fall off at `}`
