// What the runtime cannot do: a negative length or a stream that is not open
// gives -1, and a block too big for the machine is null, which the program can
// go on from.
import "core:allocator";

fn main() {
    let negative: i32 = -1;
    println(Write(Stdout, c"x", negative), Read(Stdin, c"abc", negative));
    println(Read(negative, c"abc", 1));
    let huge: usize = 1;
    println(allocator::Malloc(huge << 62) == none);
    println("went on");
}
