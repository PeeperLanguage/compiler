enum Mode { A, B, C }
struct Counter { total: i32 }
struct Cursor { value: i32, limit: i32 }

fn Touch(value: i32) {}

// A missing return is reported only when some path reaches the end of the
// function without returning. A branch that does not return is no error while
// code after it does, so the valid functions below must stay silent.

fn OuterReturn(a: i32) -> i32 {
    if a > 0 {
        Touch(a);
    }
    return 2;
}

fn NestedOuterReturn(a: i32, b: i32) -> i32 {
    if a > 0 {
        if b > 0 {
            return 1;
        }
    }
    return 3;
}

fn EveryBranchReturns(a: i32) -> i32 {
    if a > 0 {
        return 1;
    } else {
        return 2;
    }
}

fn EveryArmReturns(mode: Mode) -> i32 {
    match mode {
        Mode::A => { return 1; }
        Mode::B => { return 2; }
        Mode::C => { return 3; }
    }
}

fn ReturnAfterLoop(n: i32) -> i32 {
    for i in 0..n {
        if i > 2 {
            break;
        }
    }
    return 7;
}

// Nothing returns: the end of the function is the cause.
fn OnlyStatements(a: i32) -> i32 {
    Touch(a);
}

fn EmptyBody() -> i32 {
}

// Statements after an `if` separate it from the end, so only the end is named.
fn TailAfterIf(a: i32) -> i32 {
    if a > 0 {
        return 1;
    }
    Touch(a);
    Touch(a);
}

fn TailAfterBranches(a: i32) -> i32 {
    if a > 0 {
        Touch(1);
    } else {
        Touch(2);
    }
    Touch(3);
}

// The function ends right after the construct, so the construct is named.
fn IfWithoutElse(a: i32) -> i32 {
    if a > 0 {
        return 1;
    }
}

fn BranchEnds(a: i32) -> i32 {
    if a > 0 {
        return 1;
    } else {
        Touch(a);
    }
}

fn ElseIfWithoutElse(a: i32) -> i32 {
    if a > 0 {
        return 1;
    } else if a < 0 {
        return 2;
    }
}

fn NestedIf(a: i32, b: i32) -> i32 {
    if a > 0 {
        if b > 0 {
            return 1;
        }
    } else {
        return 2;
    }
}

fn InnerThenFalls(a: i32, b: i32) -> i32 {
    if a > 0 {
        if b > 0 {
            return 1;
        }
        Touch(b);
    }
}

fn TwoIfs(a: i32, b: i32) -> i32 {
    if a > 0 {
        Touch(1);
    }
    if b > 0 {
        Touch(2);
    }
}

fn EmptyBranch(a: i32) -> i32 {
    if a > 0 {
    }
}

fn ManyCauses(a: i32, b: i32, c: i32, d: i32) -> i32 {
    if a > 0 {
        Touch(1);
    } else if b > 0 {
        Touch(2);
    } else if c > 0 {
        Touch(3);
    } else if d > 0 {
        Touch(4);
    }
}

fn LoopMayEndEmpty(n: i32) -> i32 {
    for i in 0..n {
        return i;
    }
}

fn LoopWithContinue(n: i32) -> i32 {
    for i in 0..n {
        if i > 1 {
            continue;
        }
        return i;
    }
}

fn LoopCondition(a: i32) -> i32 {
    let mut b = a;
    for b > 0 {
        b = b - 1;
    }
}

fn LoopBreak(a: i32) -> i32 {
    for {
        if a > 0 {
            break;
        }
        return 1;
    }
}

fn LoopInBranch(a: i32, n: i32) -> i32 {
    if a > 0 {
        for i in 0..n {
            return i;
        }
    } else {
        return 2;
    }
}

fn MatchArmEnds(mode: Mode) -> i32 {
    match mode {
        Mode::A => { return 1; }
        Mode::B => { Touch(2); }
        Mode::C => { return 3; }
    }
}

fn MatchArmsEnd(mode: Mode) -> i32 {
    match mode {
        Mode::A => { Touch(1); }
        Mode::B => { Touch(2); }
        Mode::C => { return 3; }
    }
}

fn ConstantCondition() -> i32 {
    if false {
        return 1;
    }
}

fn (self: &Counter) Read() -> i32 {
    if self.total > 0 {
        return 1;
    }
}

// An empty branch has no statement to point at, so the condition or the arm is.
fn EmptyThenAndNoElse(a: i32) -> i32 {
    if a > 0 {
    }
}

fn EmptyThenOnly(a: i32) -> i32 {
    if a > 0 {
    } else {
        return 1;
    }
}

fn EmptyElse(a: i32) -> i32 {
    if a > 0 {
        return 1;
    } else {
    }
}

fn EmptyArm(mode: Mode) -> i32 {
    match mode {
        Mode::A => {}
        Mode::B => { return 1; }
        Mode::C => { return 2; }
    }
}

fn EmptyArmAfterStatement(a: i32, mode: Mode) -> i32 {
    Touch(a);
    match mode {
        Mode::A => {}
        Mode::B => { return 1; }
        Mode::C => { return 2; }
    }
}

fn EmptyArmInBranch(a: i32, mode: Mode) -> i32 {
    if a > 0 {
        Touch(a);
        match mode {
            Mode::A => {}
            Mode::B => { return 1; }
            Mode::C => { return 2; }
        }
    } else {
        return 0;
    }
}

// A call iteration leaves its loop through a `break` the compiler writes, so
// the loop is named and not a `break` the user never wrote.
fn (self: &mut Cursor) Next() -> ?i32 {
    if self.value >= self.limit { return none; }
    self.value = self.value + 1;
    return self.value;
}

fn CallIteration(cursor: &mut Cursor) -> i32 {
    for item in cursor.Next() {
        if item > 2 { return item; }
    }
}

// A short-circuit condition is moved into the loop body by the compiler, along
// with a `break` the user never wrote; the label still names the loop.
fn ShortCircuitLoop(a: i32, b: i32) -> i32 {
    for a > 0 && b > 0 {
        Touch(a);
    }
}
