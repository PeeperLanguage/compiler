fn make:
  bb0:
    store n.0, arg0
    store step.1, arg1
    %2 = load n.0: i32
    %3 = load n.0: i32
    %4 = Add %3, 6: i32
    %5 = load step.1: u32
    %6 = EqualTo %5, 0: bool
    check %6, "range step is zero"
    %8 = LessOrEqual %2, %4: bool
    branch %8 (n..n + 6:step) bb1 bb2
  bb1:
    %9 = Subtract %4, %2: i32
    %10 = convert %9: u32
    %11 = convert %5: i32
    goto bb3
  bb2:
    %12 = Subtract %2, %4: i32
    %13 = convert %12: u32
    %14 = convert %5: i32
    %15 = Subtract 0, %14: i32
    goto bb3
  bb3:
    %16 = phi bb1: %10, bb2: %13: u32
    %17 = phi bb1: %11, bb2: %15: i32
    %18 = array(9, range(%2, left %16, inclusive false, step %5, delta %17)...): [4]i32
    scope end step.1
    scope end n.0
    return %18
  bb4:
    scope end step.1
    scope end n.0
    fall off at `}`
fn join:
  bb0:
    store pair.0, arg0
    %1 = load pair.0: [2]i32
    %2 = array(%1..., 7): [3]i32
    scope end pair.0
    return %2
  bb1:
    scope end pair.0
    fall off at `}`
fn main:
  bb0:
    %0 = call make(1, 2): [4]i32
    %1 = aggregate(5, 6): [2]i32
    %2 = call join(%1): [3]i32
    println(%0, %2)
    fall off at `}`
