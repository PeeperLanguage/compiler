fn make:
  bb0:
    store n.0, arg0
    store step.1, arg1
    %2 = load n.0: i32
    %3 = load n.0: i32
    %4 = Add %3, 6: i32
    %5 = load step.1: u32
    %6 = EqualTo %5, 0: bool
    check %6, "range step is zero"
    %8 = LessOrEqual %2, %4: bool
    branch %8 (n..n + 6:step) bb1 bb2
  bb1:
    %9 = Subtract %4, %2: i32
    %10 = convert %9: u32
    %11 = convert %5: i32
    goto bb3
  bb2:
    %12 = Subtract %2, %4: i32
    %13 = convert %12: u32
    %14 = convert %5: i32
    %15 = Subtract 0, %14: i32
    goto bb3
  bb3:
    %16 = phi bb1: %10, bb2: %13: u32
    %17 = phi bb1: %11, bb2: %15: i32
    %18 = aggregate(%2, %16, %5, %17, false): range[i32]
    %19 = array(9, %18): [4]i32
    return %19
fn join:
  bb0:
    store pair.0, arg0
    %1 = load pair.0: [2]i32
    %2 = array(%1, 7): [3]i32
    return %2
fn main:
  bb0:
    %0 = call make(1, 2): [4]i32
    store made.0, %0
    %2 = aggregate(5, 6): [2]i32
    %3 = call join(%2): [3]i32
    store joined.1, %3
    %5 = load made.0[at 0]: i32
    %6 = load made.0[at 1]: i32
    %7 = load made.0[at 2]: i32
    %8 = load made.0[at 3]: i32
    %9 = load joined.1[at 0]: i32
    %10 = load joined.1[at 1]: i32
    %11 = load joined.1[at 2]: i32
    println(%5, %6, %7, %8, %9, %10, %11)
    fall off at `}`
