fn check:
  bb0:
    store n.0, arg0
    %1 = load n.0: i32
    %2 = Multiply %1, 2: i32
    store doubled.1, %2
    %4 = load doubled.1: i32
    %5 = GreaterThan %4, 10: bool
    branch %5 (doubled > 10) bb1 bb2
  bb1:
    panic c"too big"
  bb2:
    %6 = load doubled.1: i32
    scope end doubled.1
    scope end n.0
    return %6
  bb3:
    goto bb2
  bb4:
    scope end doubled.1
    scope end n.0
    fall off at `}`
fn each:
  bb0:
    %0 = NotEqualTo 3, 0: bool
    goto bb1
  bb1:
    %1 = phi bb0: 0, bb4: %6: i32
    %2 = phi bb0: 3, bb4: %7: u32
    %3 = phi bb0: %0, bb4: %5: bool
    branch %3 (0..3) bb2 bb3
  bb2:
    store v.0, %1
    %5 = GreaterThan %2, 1: bool
    %6 = Add %1, 1: i32
    %7 = Subtract %2, 1: u32
