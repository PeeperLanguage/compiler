fn check:
  bb0:
    store i32 n.0, arg0
    %1 = load i32 n.0
    %2 = mul i32 %1, 2
    store i32 doubled.1, %2
    %4 = load i32 doubled.1
    %5 = slt i32 10, %4
    branch %5, bb1, bb2
  bb1:
    panic global 0
  bb2:
    %6 = load i32 doubled.1
    dead doubled.1
    dead n.0
    return %6
  bb3:
    jump bb2
  bb4:
    dead doubled.1
    dead n.0
    fall off at `}`
  global 0 = "too big"
fn each:
  bb0:
    %0 = ne i32 3, 0
    store i32 .1, 0
    store i32 .2, 3
    store i8 .3, %0
    jump bb1
  bb1:
    %4 = load i8 .3
    branch %4, bb2, bb3
  bb2:
    %5 = load i32 .1
    %6 = load i32 .2
    store i32 v.0, %5
    %8 = ult i32 1, %6
    %9 = add i32 %5, 1
    %10 = sub i32 %6, 1
    store i32 .1, %9
    store i32 .2, %10
    store i8 .3, %8
    panic global 0
  bb3:
    dead .3
    dead .2
    dead .1
    fall off at `}`
  bb4:
    jump bb1
  bb5:
    dead v.0
    jump bb4
  global 0 = "in a loop"
fn main:
  bb0:
    %0 = call check(2)
    %1 = sext i32 %0 to i64
    store i64 .0, %1
    %3 = address 8 .0
    call peeper_rt_v2_print_int(1, 1, %3)
    call peeper_rt_v1_print_bytes(global 0, 1)
    call peeper_rt_v1_flush()
    dead .0
    call each()
    fall off at `}`
  global 0 = "\n"
