#[extern("free")]
fn ReleaseRaw(ptr: rawptr);

struct Box {
    value: i32,
    ptr: *i32
}

fn MakeBox() -> Box {
    return .Box{ value = 7, ptr = alloc(0) };
}

fn ReadTemporary() -> i32 {
    return MakeBox().value;
}

fn ReadFieldAddress() {
    let box = .Box{ value = 7, ptr = alloc(0) };
    let raw: rawptr = @box.value;
    print(raw);
}

fn ReplaceBoxField() {
    let mut box = .Box{ value = 7, ptr = alloc(0) };
    box.ptr = alloc(0);
}

fn ReleaseAll(_: []*i32) {}

fn main() -> i32 {
    let mut first = alloc(0);
    {
        let nested = alloc(0);
    }
    let next = alloc(0);
    first = next;
    let early = alloc(0);
    free(early);
    alloc(0);
    .Box{ value = 0, ptr = alloc(0) };
    [1]*i32{alloc(0)};
    let _ = ReadTemporary();
    ReadFieldAddress();
    ReplaceBoxField();
    return 0;
}
