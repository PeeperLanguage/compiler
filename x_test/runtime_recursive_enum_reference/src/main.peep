enum Node {
    Next: { next: &Node },
    End
}

fn Read(_: &Node) {}

fn main() -> i32 {
    let end = Node::End;
    let node = Node::Next{ next = &end };
    let mut result = 1;
    match node {
        Node::Next{ next = next } => {
            Read(next);
            result = 0;
        }
        Node::End => {}
    }
    return result;
}
