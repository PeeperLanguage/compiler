enum Node {
    Next: struct { next: &Node },
    End
}

fn Read(_: &Node) {}

fn main() -> i32 {
    let end = Node::End;
    let node = Node::Next with .{ next = &end };
    let mut result = 1;
    match node {
        Node::Next => {
            Read(node.next);
            result = 0;
        }
        Node::End => {}
    }
    return result;
}
