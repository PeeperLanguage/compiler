// A field write is one store along the field path from the variable; a
// whole assignment moves a whole value in.
struct Point { x: i32, y: i32 }
struct Line { start: Point, end: Point }

fn main() {
    let mut line = Line.{ start = Point.{ x = 1, y = 2 }, end = Point.{ x = 3, y = 4 } };
    line.start.y = 5;
    let other = Point.{ x = 6, y = 7 };
    line.end = other;
}
