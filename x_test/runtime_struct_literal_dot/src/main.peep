import "runtime_struct_literal_dot/models";

struct Point {
    x: i32,
    y: i32
}

struct Box<T> {
    value: T,
    tag: i32
}

enum State {
    Ready,
    Waiting
}

fn main() -> i32 {
    let named = Point.{ x = 1, y = 2 };
    let generic = Box<i32>.{ value = 3, tag = 4 };
    let qualified = models::Point.{ x = 5, y = 6 };
    let qualified_generic = models::Box<i32>.{ value = 7, tag = 8 };
    let nested = Box<models::Box<Point>>.{
        value = models::Box<Point>.{ value = Point.{ x = 9, y = 10 }, tag = 11 },
        tag = 12
    };
    let contextual: Box<Point> = .{ value = .{ x = 13, y = 14 }, tag = 15 };
    if named.x + named.y != 3 || generic.value + generic.tag != 7 {
        return 1;
    }
    if qualified.x + qualified.y != 11 || qualified_generic.value + qualified_generic.tag != 15 {
        return 2;
    }
    if nested.value.value.x + nested.value.value.y + nested.value.tag + nested.tag != 42 {
        return 3;
    }
    if contextual.value.x + contextual.value.y + contextual.tag != 42 {
        return 4;
    }

    if 1 < Box<Box<i32>>.{ value = .{ value = 2, tag = 0 }, tag = 0 }.value.value {
        let mut count = 0;
        for count < models::Box<i32>.{ value = 2, tag = 0 }.value {
            count = count + 1;
        }
        if count != 2 {
            return 5;
        }
    } else {
        return 6;
    }
    let mut sum = 0;
    for item in Point.{ x = 3, y = 0 }.x..models::Point.{ x = 5, y = 0 }.x {
        sum = sum + item;
    }
    if sum != 7 {
        return 7;
    }
    match Box<State>.{ value = State::Ready, tag = 0 }.value {
        State::Ready => { println("struct literal dot ok"); }
        State::Waiting => { return 8; }
    }
    {
        sum = sum + 1;
    }
    if sum != 8 {
        return 9;
    }
    return 0;
}
