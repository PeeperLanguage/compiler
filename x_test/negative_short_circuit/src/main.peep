struct Item { value: i32 }

fn Consume(item: Item) -> bool { return item.value > 0; }

// The right side of `&&` runs when the left side is true: after `== none`
// there is no payload to read.
fn WrongSide(maybe: ?i32) -> bool { return maybe == none && maybe > 3; }

// The right side of `||` runs when the left side is false.
fn WrongSideOfOr(maybe: ?i32) -> bool { return maybe != none || maybe > 3; }

// A block does not get the names of the parts of its condition.
fn NotInBlock(first: ?i32, second: ?i32) -> i32 {
    if first != none && second != none { return first + second; }
    return 0;
}

// The right side may not run, so a value moved there is moved on one path only.
fn MovedOnOnePath(ready: bool) -> bool {
    let item = Item.{ value = 1 };
    return ready && Consume(item);
}
