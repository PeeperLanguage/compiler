import "import_default_parameters/helpers";

const value: i32 = 7;

fn Add(base: i32, step: i32 = base + helpers::Value()) -> i32 {
    return base + step;
}

fn TakePointer(_: rawptr = @value) {}

fn Borrow(pointer: &i32 = &value) -> &i32 from pointer {
    return pointer;
}

fn Read(_: &i32) {}

enum Status<T> {
    Ready: {
        value: T,
    },
    Pending,
}

type State<T> = Status<T>;

fn StateCode(status: State<i32> = State<i32>::Ready{ value = 42 }) -> i32 {
    match status {
        State<i32>::Ready{ value = value } => {
            return value;
        }
        State<i32>::Pending => {
            return 0;
        }
    }
}

fn IsPending(pending: bool = State<i32>::Pending is State<i32>::Pending) -> bool {
    return pending;
}
