// `core:memory`'s `Heap` gives memory and takes it back. `free` is an
// ordinary name.
import "core:memory";

fn free(count: i32) -> i32 { return count + 1; }

fn main() {
    let mut heap = memory::Heap.{};
    let block = heap.Allocate(8, 4);
    let numbers = block as *i32;
    numbers.* = 7;
    println(numbers.*, 9);
    heap.Free(block);
    println("free", free(2));
}
