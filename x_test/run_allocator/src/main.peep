// `core:allocator`'s `Heap` gives memory and takes it back. `free` is an
// ordinary name.
import "core:allocator";

fn free(count: i32) -> i32 { return count + 1; }

fn main() {
    let mut heap = allocator::Heap.{};
    let memory = heap.Allocate(8, 4);
    let numbers = memory as *i32;
    numbers.* = 7;
    println(numbers.*, 9);
    heap.Free(memory);
    println("free", free(2));
}
