struct Pair {
    left: i32,
    right: i32
}

struct Counter {
    value: i32
}

fn Keep(_: &mut i32) {
}

fn KeepRaw(_: rawptr) {
}

fn ReadPair(value: &Pair) -> i32 {
    return value.left;
}

fn KeepPair(_: &mut Pair, current: i32) -> i32 {
    return current;
}

fn Index(_: &mut [2]i32) -> usize {
    return 0;
}

fn (self: &Counter) Current() -> i32 {
    return self.value;
}

fn (self: &mut Counter) Add(delta: i32) {
    self.value = self.value + delta;
}

fn main() -> i32 {
    let mut pair: Pair = .{ left = 1, right = 2 };
    let left = &mut pair.left;
    pair.right = 7;
    KeepRaw(@pair.right);
    Keep(left);

    let nested = KeepPair(&mut pair, ReadPair(&pair));
    if nested != 1 {
        return 1;
    }

    let mut counter: Counter = .{ value = 3 };
    counter.Add(counter.Current());
    if counter.value != 6 {
        return 2;
    }

    let mut values = [_]i32{1, 2};
    let first = &mut values[0];
    values[1] = pair.right;
    Keep(first);

    let reference = &mut values;
    Keep(&mut values[Index(reference)]);

    if values[1] == 7 {
        return 0;
    }
    return 3;
}
