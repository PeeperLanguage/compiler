enum Shape {
    Circle: struct { radius: i32 },
    Code: i32,
    Empty
}

enum Slot {
    Value: ?i32,
    Inner: Shape,
    Free
}

// A pattern after `with` tests the payload of its case and names what it
// takes. An arm without a name reads what it selects under the subject's name.
fn Read(slot: Slot) -> i32 {
    match slot {
        Slot::Value with value => { return value; }
        Slot::Value with none => { return -1; }
        Slot::Inner with Shape::Circle => { return slot.radius; }
        Slot::Inner with Shape::Code with code => { return code + 100; }
        Slot::Inner with Shape::Empty => { return -2; }
        Slot::Free => { return -3; }
    }
}

// Whole-case arms and patterns mix freely between cases. A whole-case arm
// after a pattern selects what the pattern left: here the value.
fn Mixed(slot: Slot) -> i32 {
    match slot {
        Slot::Inner => { return 1; }
        Slot::Value with none => { return 2; }
        Slot::Free => { return 3; }
        Slot::Value => { return slot * 2; }
    }
}

struct Holder { slot: Slot }

fn Bump(mut holder: Holder) -> i32 {
    match &mut holder.slot {
        Slot::Inner with Shape::Circle => { slot.radius = slot.radius + 1; }
        Slot::Inner with Shape::Code => { holder.slot = Slot::Free; }
        Slot::Inner with Shape::Empty => {}
        Slot::Value => {}
        Slot::Free => {}
    }
    return Read(holder.slot);
}

fn main() -> i32 {
    if Read(Slot::Value with 7) != 7 { return 1; }
    if Read(Slot::Value with none) != -1 { return 2; }
    if Read(Slot::Inner with Shape::Circle with .{ radius = 4 }) != 4 { return 3; }
    if Read(Slot::Inner with Shape::Code with 5) != 105 { return 4; }
    if Read(Slot::Inner with Shape::Empty) != -2 { return 5; }
    if Read(Slot::Free) != -3 { return 6; }
    if Mixed(Slot::Value with 21) != 42 { return 7; }
    if Mixed(Slot::Value with none) != 2 { return 8; }
    if Mixed(Slot::Inner with Shape::Empty) != 1 { return 9; }
    if Bump(Holder.{ slot = Slot::Inner with Shape::Circle with .{ radius = 1 } }) != 2 { return 10; }
    if Bump(Holder.{ slot = Slot::Inner with Shape::Code with 1 }) != -3 { return 11; }
    return 0;
}
