// Each cast runs on a value passed to a function, so it is computed at run
// time, and on a constant, which check folds: the two must agree. `same`
// counts the casts where they do.
const Big: i32 = 300;
const Negative: i32 = -1;
const Wide: i64 = 9007199254740993; // 2^53 + 1: not an `f64`
const Huge: f64 = 1e20;
const Half: f64 = -2.5;
const Tiny: f64 = 0.1;
const Above: u200 = 1 << 150;
const Below: i200 = -(1 << 150);
const NearTop: u200 = (1 << 128) - (1 << 103); // rounds up to infinity as an `f32`
const Lowest: i129 = -(1 << 127) * 2; // -2^128: rounds to -infinity as an `f32`
const NotANumber: f64 = 0.0 / 0.0;
const Infinite: f64 = 1.0 / 0.0;
const Single: f32 = -3.75;
const Large: f32 = 1e30;

fn to_u8(value: i32) -> u8 { return value as u8; }
fn to_u32(value: i32) -> u32 { return value as u32; }
fn to_i64(value: i32) -> i64 { return value as i64; }
fn to_f64(value: i64) -> f64 { return value as f64; }
fn to_f32(value: f64) -> f32 { return value as f32; }
fn to_i32(value: f64) -> i32 { return value as i32; }
fn to_u16(value: f64) -> u16 { return value as u16; }
fn wide_to_f32(value: u200) -> f32 { return value as f32; }
fn signed_to_f32(value: i200) -> f32 { return value as f32; }
fn edge_to_f32(value: i129) -> f32 { return value as f32; }
fn float_to_i64(value: f64) -> i64 { return value as i64; }
fn single_to_i8(value: f32) -> i8 { return value as i8; }
fn single_to_u128(value: f32) -> u128 { return value as u128; }
fn to_i200(value: f64) -> i200 { return value as i200; }
fn flag(value: bool) -> u8 { return value as u8; }

fn main() -> i32 {
    let mut same = 0;
    if to_u8(Big) == Big as u8 { same = same + 1; } // 44
    if to_u32(Negative) == Negative as u32 { same = same + 1; } // 4294967295
    if to_i64(Negative) == Negative as i64 { same = same + 1; }
    if to_f64(Wide) == Wide as f64 { same = same + 1; } // rounds to 2^53
    if to_f32(Tiny) == Tiny as f32 { same = same + 1; }
    if to_i32(Huge) == Huge as i32 { same = same + 1; } // saturates
    if to_i32(Half) == Half as i32 { same = same + 1; } // -2
    if to_u16(Half) == Half as u16 { same = same + 1; } // 0
    if wide_to_f32(Above) == Above as f32 { same = same + 1; } // infinity
    if flag(true) == true as u8 { same = same + 1; }
    if signed_to_f32(Below) == Below as f32 { same = same + 1; } // -infinity
    if wide_to_f32(NearTop) == NearTop as f32 { same = same + 1; } // infinity
    if edge_to_f32(Lowest) == Lowest as f32 { same = same + 1; } // -infinity
    if to_i32(NotANumber) == NotANumber as i32 { same = same + 1; } // 0
    if float_to_i64(Infinite) == Infinite as i64 { same = same + 1; } // maximum
    if float_to_i64(-Infinite) == -Infinite as i64 { same = same + 1; } // minimum
    if single_to_i8(Single) == Single as i8 { same = same + 1; } // -3
    if single_to_u128(Large) == Large as u128 { same = same + 1; }
    if single_to_i8(Large) == Large as i8 { same = same + 1; } // 127
    if to_i200(1e300) == 1e300 as i200 { same = same + 1; } // maximum
    if to_i200(-1e300) == -1e300 as i200 { same = same + 1; } // minimum
    if to_i200(-2.5e40) == -2.5e40 as i200 { same = same + 1; }
    let checks = (Big as u8 == 44) && (Huge as i32 == 2147483647) && (Half as i32 == -2)
        && (NotANumber as i32 == 0) && (Large as i8 == 127) && (-Infinite as i8 == -128);
    if checks { same = same + 1; }
    return same + 19; // 23 + 19
}
