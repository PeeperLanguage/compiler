struct Box { value: i32 }
struct Point { x: i32, y: i32, z: i32 }
struct Pair { first: *Box, second: *Box, tag: i32 }
enum Resource {
    Owned: struct { value: *Box, extra: *Box },
    Empty
}
enum View {
    Borrowed: struct { value: &Box, tag: i32 },
    Empty
}

fn MakePair(n: i32) -> Pair {
    return Pair.{ first = alloc(Box.{ value = n }), second = alloc(Box.{ value = n + 1 }), tag = 7 };
}

fn Read(box: &Box) -> i32 { return box.value; }

fn Take(resource: Resource) -> i32 {
    match resource {
        Resource::Owned => {
            let .{ value = owned, _ } = resource;
            let n = owned.value;
            free(owned);
            return n;
        }
        Resource::Empty => { return 0; }
    }
}

fn main() -> i32 {
    let .{ x = a, z = c, _ } = Point.{ x = 1, y = 2, z = 3 };
    if a + c != 4 { return 1; }

    let mut total: i32 = 0;
    for i in 0..100 {
        let pair = MakePair(i);
        let .{ first = head, _ } = pair;
        total = total + head.value - i;
        free(head);
        let .{ second = tail, tag = tag, _ } = MakePair(i);
        total = total + tail.value - i - 1 + tag - 7;
    }
    if total != 0 { return 2; }

    let owned = Resource::Owned with .{ value = alloc(Box.{ value = 5 }), extra = alloc(Box.{ value = 9 }) };
    if owned is Resource::Owned {
        let .{ value = v, extra = e } = owned;
        if v.value + e.value != 14 { return 3; }
    } else {
        return 4;
    }
    if Take(Resource::Owned with .{ value = alloc(Box.{ value = 6 }), extra = alloc(Box.{ value = 1 }) }) != 6 { return 5; }

    let mut target: Box = .{ value = 4 };
    let borrowed = View::Borrowed with .{ value = &target, tag = 2 };
    match borrowed {
        View::Borrowed => {
            let .{ value = view, tag = tag } = borrowed;
            if Read(view) + tag != 6 { return 6; }
            target.value = 9;
        }
        View::Empty => { return 7; }
    }
    return target.value - 9;
}
