// `size_of` and `align_of` take a type and give a `usize` constant for the
// target being built.

struct Node {
    value: i32,
    next: *Node,
}

iface Shape {
    fn Area(&self) -> i32,
}

const NODE_BYTES = size_of(Node);

fn main() {
    // A struct, with padding before `next`, and a pointer to one.
    println(NODE_BYTES, align_of(Node), size_of(*Node), size_of(rawptr));
    // Numbers, and a struct declared after its use.
    println(size_of(i8), size_of(i32), align_of(u64), size_of(usize), size_of(Late));
    // Arrays: written as a type alone, and nested.
    println(size_of([4]i32), size_of([3][2]u16), align_of([4]i32));
    // References that are two words: text, slices and interfaces.
    println(size_of(&str), size_of(&[]i32), size_of(&mut []u8), size_of(&Shape));
    // A plain reference, a range, a C string, and a type in parentheses.
    println(size_of(&Node), size_of(range[i32]), size_of(&cstr), size_of((Node)));
    // The block a node needs is worked out, not guessed.
    let count: usize = 3;
    println(count * size_of(Node));
}

struct Late {
    a: u8,
    b: u16,
}
