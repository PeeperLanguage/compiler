enum Choice { First, Second }

// A local declared without a value and first assigned in a match arm is read
// after the match.
fn Pick(choice: Choice) -> i32 {
    let mut picked: i32;
    match choice {
        Choice::First => { picked = 1; }
        Choice::Second => { return 0; }
    }
    return picked + 1;
}

fn main() -> i32 {
    if Pick(Choice::First) != 2 { return 1; }
    if Pick(Choice::Second) != 0 { return 2; }
    return 0;
}
