fn make:
  bb0:
    %0 = aggregate(1, 2, 3): [3]i32
    return %0
fn pick:
  bb0:
    return 1
fn sum:
  bb0:
    store values.0, arg0
    store total.1, 0
    %2 = NotEqualTo 4, 0: bool
    goto bb1
  bb1:
    %3 = phi bb0: 0, bb4: %8: u64
    %4 = phi bb0: 4, bb4: %9: u64
    %5 = phi bb0: %2, bb4: %7: bool
    branch %5 (0..values.len) bb2 bb3
  bb2:
    store i.2, %3
    %7 = GreaterThan %4, 1: bool
    %8 = Add %3, 1: u64
    %9 = Subtract %4, 1: u64
    %10 = load total.1: i32
    %11 = load i.2: u64
    %12 = load values.0.*[at %11]: i32
    %13 = Add %10, %12: i32
    store total.1, %13
    goto bb4
  bb3:
    %16 = load total.1: i32
    return %16
  bb4:
    goto bb1
fn lengths:
  bb0:
    %0 = aggregate(1, 2, 3): [3]i32
    %1 = aggregate(4, 5, 6): [3]i32
    %2 = aggregate(%0, %1): [2][3]i32
    store grid.0, %2
    %4 = call pick(): i32
    %5 = call make(): [3]i32
    %6 = Add 3, 3: u64
    return %6
