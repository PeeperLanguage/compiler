fn make:
  bb0:
    store i32 result[+0], 1
    store i32 result[+4], 2
    store i32 result[+8], 3
    return
  bb1:
    fall off at `}`
fn pick:
  bb0:
    return 1
  bb1:
    fall off at `}`
fn sum:
  bb0:
    store ptr values.0, arg0
    store i32 total.1, 0
    %2 = ne i64 4, 0
    store i64 .3, 0
    store i64 .4, 4
    store i8 .5, %2
    jump bb1
  bb1:
    %6 = load i8 .5
    branch %6, bb2, bb3
  bb2:
    %7 = load i64 .3
    %8 = load i64 .4
    store i64 i.2, %7
    %10 = ult i64 1, %8
    %11 = add i64 %7, 1
    %12 = sub i64 %8, 1
    store i64 .3, %11
    store i64 .4, %12
    store i8 .5, %10
    %16 = load i32 total.1
    %17 = load i64 i.2
    %18 = ule i64 4, %17
    check %18, "index out of bounds: the length is 4"
    %20 = load i32 values.0[*, %17 * 4 of 4]
    %21 = add i32 %16, %20
    store i32 total.1, %21
    dead i.2
    jump bb4
  bb3:
    dead .5
    dead .4
    dead .3
    %27 = load i32 total.1
    dead total.1
    dead values.0
    return %27
  bb4:
    jump bb1
  bb5:
    dead total.1
    dead values.0
    fall off at `}`
fn lengths:
  bb0:
    store i32 .1[+0], 1
    store i32 .1[+4], 2
    store i32 .1[+8], 3
    store i32 .2[+0], 4
    store i32 .2[+4], 5
    store i32 .2[+8], 6
    copy 12 grid.0[+0], .1
    copy 12 grid.0[+12], .2
    dead .2
    dead .1
    %10 = call pick()
    %11 = sext i32 %10 to i64
    %12 = ule i64 2, %11
    check %12, "index out of bounds: the length is 2"
    store i64 .3, 3
    %15 = load i64 .3
    call make() into 12 .4
    store i64 .5, 3
    %18 = load i64 .5
    %19 = add i64 %15, %18
    dead .5
    dead .4
    dead .3
    dead grid.0
    return %19
  bb1:
    dead grid.0
    fall off at `}`
