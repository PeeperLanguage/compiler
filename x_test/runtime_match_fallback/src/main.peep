enum Shape {
    Circle: struct { radius: i32 },
    Code: i32,
    Empty
}

enum Slot {
    Value: ?i32,
    Inner: Shape,
    Free
}

// `_` handles every case the arms before it do not.
fn Radius(shape: Shape) -> i32 {
    match shape {
        Shape::Circle => { return shape.radius; }
        _ => { return -1; }
    }
}

// When one case is left, the subject is that case's payload in the `_` arm.
fn LastCase(shape: Shape) -> i32 {
    match shape {
        Shape::Circle => { return 0; }
        Shape::Empty => { return 0; }
        _ => { return shape + 1; }
    }
}

// `_` also takes the payload cases a tested case leaves open.
fn Present(slot: Slot) -> i32 {
    match slot {
        Slot::Value != none => { return slot; }
        _ => { return -1; }
    }
}

fn OnlyNoneLeft(slot: Slot) -> i32 {
    match slot {
        Slot::Value != none => { return slot; }
        Slot::Inner => { return -2; }
        Slot::Free => { return -3; }
        _ => { return -1; }
    }
}

fn Count(mut total: i32, shape: Shape) -> i32 {
    match shape {
        Shape::Code => { total = total + shape; }
        _ => {}
    }
    return total;
}

fn main() -> i32 {
    if Radius(Shape::Circle with .{ radius = 3 }) != 3 { return 1; }
    if Radius(Shape::Code with 9) != -1 { return 2; }
    if Radius(Shape::Empty) != -1 { return 3; }
    if LastCase(Shape::Code with 9) != 10 { return 4; }
    if Present(Slot::Value with 5) != 5 { return 5; }
    if Present(Slot::Value with none) != -1 { return 6; }
    if Present(Slot::Inner with Shape::Empty) != -1 { return 7; }
    if Present(Slot::Free) != -1 { return 8; }
    if OnlyNoneLeft(Slot::Value with none) != -1 { return 9; }
    if OnlyNoneLeft(Slot::Free) != -3 { return 10; }
    if Count(1, Shape::Code with 4) != 5 { return 11; }
    if Count(1, Shape::Empty) != 1 { return 12; }
    return 0;
}
