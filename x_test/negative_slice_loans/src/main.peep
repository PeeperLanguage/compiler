// The loan rules hold for slices as for references: one error per function.
fn first(view: [&]i32) -> i32 {
    return view[0];
}

fn fill(view: [&mut]i32) {}

fn both(edit: [&mut]i32, view: [&]i32) {}

fn ReturnsLocal(view: [&]i32) -> [&]i32 {
    let values = [3]i32{1, 2, 3};
    return &values;
}

fn ReturnsParameter(values: [3]i32) -> [&]i32 in values {
    return &values;
}

fn ReturnsCopiedArray(values: [3]i32, view: [&]i32) -> [&]i32 {
    return &values;
}

fn ElementOfLocal(view: [&]i32) -> &i32 {
    let local = [1]i32{1};
    let slice: [&]i32 = &local;
    return &slice[0];
}

fn ElementOfUnnamed(kept: [&]i32, other: [&]i32) -> &i32 in kept {
    return &other[0];
}

fn KeptPastBlock() -> i32 {
    let outer = [1]i32{0};
    let mut view: [&]i32 = &outer;
    {
        let inner = [2]i32{1, 2};
        view = &inner;
    }
    return first(view);
}

fn ChangedWhileViewed() -> i32 {
    let mut values = [2]i32{1, 2};
    let view: [&]i32 = &values;
    values[0] = 5;
    return first(view);
}

fn ChangedWhileElementHeld() -> i32 {
    let mut values = [2]i32{1, 2};
    let view: [&]i32 = &values;
    let element = &view[0];
    values[1] = 5;
    return element.*;
}

fn TwoEdits() {
    let mut values = [2]i32{1, 2};
    let a: [&mut]i32 = &mut values;
    let b: [&mut]i32 = &mut values;
    fill(a);
    fill(b);
}

fn EditAndView() {
    let mut values = [2]i32{1, 2};
    both(&mut values, &values);
}

fn ReadWhileEdited() -> i32 {
    let mut values = [2]i32{1, 2};
    let edit: [&mut]i32 = &mut values;
    let read = values[0];
    fill(edit);
    return read;
}
