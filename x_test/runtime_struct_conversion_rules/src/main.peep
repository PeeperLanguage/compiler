struct Pair {
    x: i32,
    y: i32
}

struct ReorderedPair {
    y: i32,
    x: i32
}

type PairAlias = Pair;

fn main() -> i32 {
    let anonymous: struct { y: i32, x: i32 } = .{ x = 10, y = 20 };
    let named: ReorderedPair = .{ x = 10, y = 20 };
    let fromAnonymous: PairAlias = .{ y = 3, x = 4 };
    println("struct literal rules ok");
    return anonymous.x + named.y + fromAnonymous.x + fromAnonymous.y + 12;
}
