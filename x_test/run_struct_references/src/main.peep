// References and slices in struct fields. Each field keeps its own loans, as
// if it had a lifetime of its own in Rust, and using any part of a struct uses
// all of it.
struct Pair { first: &i32, second: &i32 }
struct Outer { pair: Pair, count: i32 }
struct Text { bytes: [&]u8 }
struct Cursor { input: [&]u8, position: usize }
struct Counter { value: &mut i32, steps: i32 }
struct Grid { cells: [&mut]i32 }
struct Point { x: i32, y: i32 }
struct Marked { point: &Point }
struct Mixed { shared: &i32, unique: &mut i32 }
struct Wrap { inner: &Pair }

fn pair_of(a: &i32, b: &i32) -> Pair {
    return Pair.{ first = a, second = b };
}

// Rust's `elided_result`: by the origin rule.
fn only(x: &i32) -> Pair {
    return Pair.{ first = x, second = x };
}

fn second_of(p: Pair) -> &i32 {
    return p.second;
}

// A value read through a reference to the holder is tied to that reference.
fn second_through(p: &Pair) -> &i32 {
    return p.second;
}

fn pick(p: Pair, other: &i32) -> &i32 in other {
    return other;
}

fn sum(text: &Text) -> i32 {
    let mut total = 0;
    for byte in text.bytes {
        total = total + byte.* as i32;
    }
    return total;
}

fn next(cursor: &mut Cursor) -> u8 {
    let byte = cursor.input[cursor.position];
    cursor.position = cursor.position + 1;
    return byte;
}

fn bump(value: &mut i32) {
    value.* = value.* + 1;
}

// A `&mut` field is lent again, not moved out: Rust's `reborrow_use` and
// `reborrow_out`.
fn step(counter: &mut Counter) {
    bump(&mut counter.value.*);
    bump(counter.value);
    counter.steps = counter.steps + 1;
}

fn value_of(counter: &mut Counter) -> &mut i32 {
    return &mut counter.value.*;
}

// A `&mut` field of a parameter lives on past the parameter.
fn take(counter: Counter) -> &mut i32 {
    return &mut counter.value.*;
}

// A result with a `&mut` field may also hold what shared parameters lend.
fn mixed(shared: &i32, unique: &mut i32) -> Mixed {
    return Mixed.{ shared = shared, unique = unique };
}

fn counter_of(value: &mut i32) -> Counter {
    return Counter.{ value = value, steps = 0 };
}

fn view(text: Text) -> [&]u8 {
    return text.bytes;
}

fn fill(cells: [&mut]i32) {
    cells[0] = 9;
}

fn total_of(cells: [&]i32) -> i32 {
    let mut total = 0;
    for cell in cells {
        total = total + cell.*;
    }
    return total;
}

// A `[&mut]` field lent again, or read as `[&]`, through a reference.
fn fill_through(grid: &mut Grid) {
    fill(grid.cells);
    fill(&mut grid.cells[0..]);
    for cell in grid.cells {
        print(cell.*, "");
    }
    println();
}

fn total_through(grid: &Grid) -> i32 {
    return total_of(grid.cells);
}

// A run at compile time holds references in a struct as well.
fn total(base: i32) -> i32 {
    let a = base;
    let b = base + 1;
    let p = Pair.{ first = &a, second = &b };
    let q = p;
    return q.first.* + q.second.*;
}

const Total = total(3);

fn main() {
    println(Total);

    let mut a = 1;
    let mut b = 2;

    // Rust accepts with two lifetimes: `p` is not used after `a` changes,
    // and `r` holds only the loans of `second`.
    let p = Pair.{ first = &a, second = &b };
    let r = p.second;
    a = 3;
    println(r.*);

    // Moving the struct takes each field's loans along.
    let moved = Pair.{ first = &a, second = &b };
    let taken = moved;
    println(taken.first.*, taken.second.*);

    // Writing the whole value replaces its loans: Rust's `whole_assign_ends_loan`.
    let mut w = Pair.{ first = &a, second = &b };
    println(w.first.*);
    w = Pair.{ first = &b, second = &b };
    a = 4;
    println(w.first.*, a);

    // Writing a field of a struct in a variable is allowed.
    let mut f = pair_of(&a, &a);
    f.first = &b;
    println(f.first.*, f.second.*);

    // Reads out of a value that is gone once its statement ends.
    let from_call = pair_of(&a, &b).second;
    println(from_call.*);
    println(only(&a).first.*);
    println(second_of(pair_of(&a, &b)).*);

    // A reference to the holder, and nesting.
    let o = Outer.{ pair = Pair.{ first = &a, second = &b }, count = 9 };
    let to_o = &o;
    let inner = to_o.pair.first;
    println(inner.*, to_o.count, o.pair.second.*);
    let to_p = &o.pair;
    println(second_through(to_p).*);

    // `in` leaves out a struct parameter.
    let kept = pick(pair_of(&a, &a), &b);
    println(kept.*);

    // A reference taken through a field outlives the holder: Rust's
    // `ref_through_holder_outlives`.
    let outlives: &i32;
    {
        let holder = Pair.{ first = &a, second = &b };
        outlives = &holder.first.*;
    }
    println(outlives.*);

    // Slices in fields, read, indexed, sliced, measured and walked.
    let bytes = [4]u8{1, 2, 3, 4};
    let text = Text.{ bytes = &bytes };
    println(text.bytes.len, text.bytes[2], sum(&text));
    // A constant index here has a check, which `&&` must count.
    println(text.bytes[0] == 1 && text.bytes[1] == 2);
    let rest = Text.{ bytes = &text.bytes[1..3] };
    println(rest.bytes.len, rest.bytes[0], sum(&rest));
    let mut cursor = Cursor.{ input = &bytes, position = 1 };
    println(next(&mut cursor), next(&mut cursor), cursor.position);

    // `&mut` fields and `[&mut]` fields.
    let mut number = 10;
    let mut counter = Counter.{ value = &mut number, steps = 0 };
    step(&mut counter);
    step(&mut counter);
    counter.value.* = counter.value.* + 5;
    println(counter.value.*, counter.steps);
    let through = value_of(&mut counter);
    through.* = through.* + 1;
    println(number);

    let taken_value = take(Counter.{ value = &mut number, steps = 0 });
    taken_value.* = taken_value.* + 1;
    println(number);

    let mut cells = [3]i32{1, 2, 3};
    let grid = Grid.{ cells = &mut cells };
    grid.cells[1] = 20;
    println(grid.cells[1], grid.cells.len);
    for cell in grid.cells {
        print(cell.*, " ");
    }
    println();

    // Fields lent to calls, sliced, spread and printed.
    fill(grid.cells);
    println(total_of(grid.cells));
    let part = &mut grid.cells[1..];
    part[0] = 5;
    let element = &grid.cells[1];
    println(element.*, [3]i32{&grid.cells[0..]...}, [4]u8{text.bytes...});
    println(view(Text.{ bytes = &text.bytes[2..] })[0]);
    println(cells[0], cells[1], cells[2]);
    let mut lent = [2]i32{1, 2};
    let mut lent_grid = Grid.{ cells = &mut lent };
    fill_through(&mut lent_grid);
    println(total_through(&lent_grid));
    let mut seven = 7;
    let shown = Pair.{ first = &a, second = &b };
    println(shown, Counter.{ value = &mut seven, steps = 1 });

    // A `&mut` field of a call's result.
    bump(counter_of(&mut number).value);
    let read = &counter_of(&mut number).value.*;
    println(read.*);
    let mut other = 1;
    let both = mixed(&number, &mut other);
    both.unique.* = both.shared.* + 1;
    println(other);

    // `p` is set again before it is read, so `a` is free in between.
    let mut looped = Pair.{ first = &b, second = &b };
    for i in 0..3 {
        println(looped.first.*);
        a = i;
        looped = Pair.{ first = &a, second = &b };
    }

    // A reference in a field to a struct that holds references.
    let wrapped = Pair.{ first = &a, second = &b };
    let wrap = Wrap.{ inner = &wrapped };
    let read_out = wrap.inner.first;
    println(read_out.*, wrap.inner.second.*);

    // A reference to a plain struct in a field.
    let point = Point.{ x = 5, y = 6 };
    let marked = Marked.{ point = &point };
    println(marked.point.x, marked.point.y);
}
