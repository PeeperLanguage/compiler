// Built for 32-bit x86 (`-target i686-linux`): what run_type_functions
// prints on 64 bits.
import "run_i686_type_functions:geometry" as g;

type P = g::Point;

// A constant may call a type's function: the call runs while compiling.
const Dimensions: i32 = g::Point::Dimensions();

fn main() {
    let mut p = g::Point::New(1, 2);
    let q = P::New(3, 4);
    println(g::Point::Sum(&p), P::Sum(&q), g::Sum(1, 2), Dimensions);
    g::Point::Shift(&mut p, 10);
    println(g::Point::X(&p).*, g::Point::Into(g::Point::Swapped(q)));
    let line = g::Line::New(p, P::New(5, 6));
    println(g::Line::Sum(&line));
    // With a dot the value is `self`: lent to `&self` and `&mut self`, given
    // to `self`, and reached through a reference.
    let mut r = P::New(1, 1);
    r.Shift(2);
    let view = &r;
    println(r.Sum(), view.X().*, line.Sum(), P::New(7, 8).Swapped().Into());
}
