enum State {
    Running: struct { ticks: i32 },
    Failed: i32,
    Idle
}

struct Machine { state: State }

// A test names the payload of the case it finds. With three cases, what is
// left after two tests is not known from a test: `match` names each case.
fn ElseSide(state: State) -> i32 {
    if state is State::Idle {
        return 0;
    } else if state is State::Failed {
        return state;
    }
    match state {
        State::Running => { return state.ticks; }
        _ => { return -1; }
    }
}

// After a guard that always leaves, the name is the payload of the case the
// guard let through.
fn AfterGuards(state: State) -> i32 {
    if state is State::Idle { return 0; }
    if !(state is State::Running) { return -1; }
    return state.ticks;
}

fn AfterNegatedGuard(state: State) -> i32 {
    if !(state is State::Failed) { return -1; }
    return state + 1;
}

// A field is tested through a reference; the name is its last field.
fn FieldPlace(mut machine: Machine) -> i32 {
    if &mut machine.state is State::Running {
        state.ticks = state.ticks + 1;
        return state.ticks;
    }
    return -1;
}

// The whole value is still there where the code asks for it.
fn Step(mut state: State) -> State {
    match state {
        State::Running => {
            if state.ticks == 3 {
                state = State::Failed with state.ticks;
            } else {
                state = State::Running with .{ ticks = state.ticks + 1 };
            }
        }
        State::Failed => { return state; }
        State::Idle => { state = State::Running with .{ ticks = 0 }; }
    }
    return state;
}

fn Code(state: State) -> i32 {
    match state {
        State::Running => { return ElseSide(state); }
        State::Failed => {
            let copy: State = state;
            if copy is State::Failed { return copy + 100; }
            return -1;
        }
        State::Idle => { return 0; }
    }
}

// Only a test that is the whole condition names a payload.
fn Both(state: State, enabled: bool) -> i32 {
    if state is State::Running {
        if enabled { return state.ticks; }
    }
    return -1;
}

fn ThroughReference(machine: &Machine) -> i32 {
    if &machine.state is State::Running { return state.ticks; }
    return -1;
}

fn main() -> i32 {
    if ElseSide(State::Idle) != 0 { return 1; }
    if ElseSide(State::Failed with 7) != 7 { return 2; }
    if ElseSide(State::Running with .{ ticks = 4 }) != 4 { return 3; }
    if AfterGuards(State::Failed with 7) != -1 { return 4; }
    if AfterGuards(State::Running with .{ ticks = 4 }) != 4 { return 5; }
    if AfterNegatedGuard(State::Failed with 1) != 2 { return 6; }
    if AfterNegatedGuard(State::Idle) != -1 { return 7; }
    if FieldPlace(Machine.{ state = State::Running with .{ ticks = 1 } }) != 2 { return 8; }
    if FieldPlace(Machine.{ state = State::Idle }) != -1 { return 9; }

    let mut state = State::Idle;
    let mut steps = 0;
    for !(state is State::Failed) {
        state = Step(state);
        steps = steps + 1;
    }
    if steps != 5 { return 10; }
    if Code(state) != 103 { return 11; }
    if Code(State::Running with .{ ticks = 9 }) != 9 { return 12; }
    if Both(State::Running with .{ ticks = 6 }, true) != 6 { return 13; }
    if Both(State::Running with .{ ticks = 6 }, false) != -1 { return 14; }
    let machine = Machine.{ state = State::Running with .{ ticks = 5 } };
    if ThroughReference(&machine) != 5 { return 17; }
    return 0;
}
