// Only `rawptr + usize` moves an address; an address is not known when
// compiling.
const Moved: rawptr = none + 8;
const Ran = Offset();

fn Offset() -> i32 {
    let at: rawptr = none;
    let moved = at + 8;
    return 1;
}

