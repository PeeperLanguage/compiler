// Struct values pass between functions in a later step.
struct Point {
    x: i32,
}

type Place = Point;

struct Pair<T> {
    first: T,
}

enum Shape {
    Circle,
}

// A field may hold an enum: its declaration is what is not supported.
struct Drawing {
    shape: Shape,
}

fn take(point: Point) {}

fn give() -> Place {}

fn main() {}
