// C functions do not take or give structs until the C ABI's struct rules are
// written; generic structs and enums come later.
struct Point {
    x: i32,
}

type Place = Point;

struct Pair<T> {
    first: T,
}

enum Shape {
    Circle,
}

// A field may hold an enum: its declaration is what is not supported.
struct Drawing {
    shape: Shape,
}

#[extern("take")]
fn take(point: Point);

#[extern("give")]
fn give() -> Place;

fn main() {}
