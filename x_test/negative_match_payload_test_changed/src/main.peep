enum Slot {
    Value: ?i32,
    Free
}

fn Clear(_: &mut Slot) {}

fn Read(mut slot: Slot) -> i32 {
    match slot {
        Slot::Value != none => {
            Clear(&mut slot);
            return slot;
        }
        Slot::Value == none => { return 0; }
        Slot::Free => { return 0; }
    }
}
