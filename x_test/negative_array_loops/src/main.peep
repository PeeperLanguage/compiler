// `for` over arrays and slices: an element that moves cannot be taken by
// value, the array or slice stays borrowed for the whole loop (a `[&mut]`
// one cannot be used in the body, as in Rust), and only ranges, arrays and
// slices loop. After an error in the header, the body is still checked.
struct Point { x: i32, y: i32 }

fn MovesElements() {
    let points = [2]Point{Point.{ x = 1, y = 2 }, Point.{ x = 3, y = 4 }};
    for point in points {
        let x: bool = point.x;
    }
}

fn ChangedWhileBorrowed() {
    let mut values = [3]i32{1, 2, 3};
    for value in &mut values {
        values[0] = 5;
        value.* = 1;
    }
}

fn ReadWhileChanged() {
    let mut values = [3]i32{1, 2, 3};
    for value in &mut values {
        let first = values[0];
        value.* = first;
    }
}

fn NotAnArray() {
    for value in 5 {
        missing(value);
    }
}

fn ReadOnlyElement() {
    let values = [3]i32{1, 2, 3};
    for value in &values {
        value.* = 1;
    }
}

fn First(s: [&]i32) -> i32 {
    return s[0];
}

fn SliceUsedInLoop(s: [&mut]i32) {
    for v in s {
        v.* = s[0];
    }
    for v in s {
        s[0] = 1;
    }
    for v in s {
        v.* = First(s);
    }
}

// `keep` borrows `s` itself, so the loop cannot lend it again.
fn SliceElementKept(s: [&mut]i32) {
    let mut keep = &mut s[0];
    for v in s {
        keep = v;
    }
    keep.* = 3;
}

// `keep` holds an element of `s` after the loop, so `s` cannot change.
fn SliceElementOutlivesLoop(s: [&mut]i32) {
    let mut other = [1]i32{0};
    let mut keep = &mut other[0];
    for v in s {
        keep = v;
    }
    s[1] = 2;
    keep.* = 3;
}

fn ReadOnlySliceElement(s: [&]i32) {
    for v in s {
        v.* = 1;
    }
}

fn main() {}
