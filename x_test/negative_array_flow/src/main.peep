// What the checks on MIR reject in arrays: moving an element out, a change
// while an element is lent (any two elements may be one), and setting an
// element of an array that is not set yet; a returned reference to one
// element holds the whole array.
struct Name { text: cstr }
struct Holder { tokens: [2]i32 }

fn slot(holder: &mut Holder) -> &mut i32 in holder {
    return &mut holder.tokens[0];
}

fn returned() {
    let mut holder = Holder.{ tokens = [2]i32{1, 2} };
    let token = slot(&mut holder);
    let other = holder.tokens[1];
    token.* = other;
}

fn moved() {
    let names = [1]Name{Name.{ text = c"a" }};
    let taken = names[0];
}

fn lent() {
    let mut values = [2]i32{1, 2};
    let first = &mut values[0];
    values[1] = 3;
    first.* = 4;
}

fn unset() {
    let mut values: [2]i32;
    values[0] = 1;
}

fn main() {
    moved();
    lent();
    unset();
    returned();
}
