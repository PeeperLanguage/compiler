struct Holder { value: rawptr }
enum Resource { Pointer: struct { value: rawptr }, Empty }

const global: i32 = 1;

// What a struct stores moves with it.
fn MovedStruct() -> rawptr {
    let local: i32 = 2;
    let holder = Holder.{ value = @local };
    let moved = holder;
    return moved.value;
}

// A payload moved out of its enum keeps what the enum stored.
fn TakenPayload() -> rawptr {
    let local: i32 = 2;
    let resource = Resource::Pointer with .{ value = @local };
    match resource {
        Resource::Pointer => {
            let taken = resource;
            return taken.value;
        }
        Resource::Empty => { return @global; }
    }
}
