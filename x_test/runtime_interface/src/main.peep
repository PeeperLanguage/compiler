iface Summer {
    fn (&Self) sum() -> i32
}

struct Point {
    x: i32,
    y: i32
}

fn (self: &Point) sum() -> i32 {
    return self.x + self.y;
}

fn total(v: &Summer) -> i32 {
    return v.sum();
}

struct Number {
    value: i32
}

fn (self: &Number) to_float() -> f32 {
    return (self.value + 1) as f32;
}

fn (_: &Number) to_str() -> cstr {
    return c"converted\n";
}

struct Counter {
    value: i32
}

fn (self: &mut Counter) bump() -> i32 {
    self.value = self.value + 1;
    return self.value;
}

fn main() {
    let p: Point = .{ x = 10, y = 20 };
    if total(&p) == 30 {
        let ok: cstr = c"interface ok\n";
        write(stdout, ok, 13);
        let number: Number = .{ value = 42 };
        let f: f32 = number.to_float();
        if f == 43.0 {
            let s: cstr = c"float ok\n";
            write(stdout, s, 9);
        }

        let s: cstr = number.to_str();
        write(stdout, s, 10);

        let mut c: Counter = .{ value = 0 };
        let v: i32 = c.bump();
        if c.value == v {
            let msg: cstr = c"both updated\n";
            write(stdout, msg, 13);
        } else {
            let msg: cstr = c"only value updated\n";
            write(stdout, msg, 19);
        }

        c.value = 100;
        if c.value == 100 {
            let msg: cstr = c"value updated to 100\n";
            write(stdout, msg, 21);
        }
    }

    let bad: cstr = c"interface bad\n";
    write(stdout, bad, 14);
}
