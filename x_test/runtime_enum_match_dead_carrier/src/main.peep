enum Result {
    Ok: struct { value: i32 },
    Error: struct { message: str },
    Pending
}

fn Show(result: Result) {
    match result {
        Result::Ok => {
            println(result.value);
        }
        Result::Error => {
            println(result.message);
        }
        Result::Pending => {
            println(2);
        }
    }
}

fn main() -> i32 {
    Show(Result::Ok with .{ value = 42 });
    Show(Result::Error with .{ message = "failed" });
    Show(Result::Pending);
    return 0;
}
