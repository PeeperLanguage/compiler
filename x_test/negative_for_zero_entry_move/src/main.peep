enum Resource {
    Owned: struct { value: *i32 },
    Pending
}

fn Invalid(resource: Resource, start: i32, end: i32) {
    for i in start..end {
        match resource {
            Resource::Owned => {
                let .{ value = owned } = resource;
                free(owned);
                break;
            }
            Resource::Pending => {
                break;
            }
        }
    }
}
