fn Find(id: i32) -> ?i32 { return none; }

fn Rename(text: &mut str) -> str { return "x"; }

// What is written before an `orelse` runs first. A value that is only looked
// at, and that moving would take away, cannot be kept aside while the `orelse`
// changes its variable.
fn ChangedBefore(text: str, other: ?str) -> bool {
    let mut mine = text;
    return mine == (other orelse Rename(&mut mine));
}

fn DefaultLeaves(id: i32 = Find(1) orelse { return 0; }) -> i32 { return id; }
