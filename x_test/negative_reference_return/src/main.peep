struct Box {
    value: i32
}

fn Missing(value: &Box) -> &Box;

fn Unknown(value: &Box) -> &Box from other;

fn Narrow(left: &Box, right: &Box) -> &Box from left {
    return right;
}

fn Local(source: &Box) -> &Box from source {
    let box: Box = .{ value = 1 };
    return &box;
}

fn Mutable(value: &Box) -> &mut Box from value;

fn InvalidCallback(_: fn(value: &Box) -> &Box) {}
