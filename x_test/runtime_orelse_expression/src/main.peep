struct Item { value: i32 }

fn Find(id: i32) -> ?i32 {
    if id > 0 { return id * 2; }
    return none;
}

fn Count(id: i32) -> i32 { println(id); return id; }

fn Add(a: i32, b: i32) -> i32 { return a + b; }

// `orelse` is an expression: the value inside an optional, or a fallback.
fn Value(id: i32) -> i32 { return Find(id) orelse 0; }

// The fallback may be a block that leaves.
fn InCall(id: i32) -> i32 { return Add(Find(id) orelse 1, Find(id + 1) orelse { return -1; }); }

fn InCondition(id: i32) -> i32 {
    if (Find(id) orelse 0) > 3 { return 1; } else if (Find(id + 5) orelse 0) > 3 { return 2; }
    return 0;
}

// The fallback runs only when it is needed: this prints 7 once, for id 0.
fn Lazy(id: i32) -> i32 { return Find(id) orelse Count(7); }

fn Chain(a: ?i32, b: ?i32) -> i32 { return a orelse b orelse 9; }

fn Assigned(id: i32) -> i32 {
    let mut total = 0;
    total = total + (Find(id) orelse 100);
    return total;
}

// A borrowed optional gives a reference to its value.
fn Borrowed(item: ?Item) -> i32 {
    return (&item orelse { return -1; }).value;
}

struct Counter { n: i32 }

fn Next(counter: &mut Counter) -> i32 { counter.n = counter.n + 1; return counter.n; }
fn Bump(counter: &mut Counter) -> i32 { counter.n = 100; return 1; }
fn Size(counter: &Counter, extra: i32) -> i32 { return counter.n + extra; }
fn Eat(item: Item, extra: i32) -> i32 { return item.value + extra; }
fn Wrap(first: ?i32, second: i32) -> i32 { return (first orelse 0) + second; }

// What is written before an `orelse` runs before it: a read sees the value
// from before, and a call runs first.
fn ReadFirst() -> i32 {
    let mut counter = Counter.{ n = 5 };
    return counter.n + (Find(0) orelse Bump(&mut counter));
}

fn CallFirst() -> i32 {
    let mut counter = Counter.{ n = 0 };
    return Add(Next(&mut counter) * 10, Find(0) orelse Next(&mut counter));
}

// The value before the `orelse` keeps what its use needs: a conversion, a
// borrow made by the call, a move.
fn Converted(first: i32) -> i32 { return Wrap(first, Find(0) orelse 2); }

fn BorrowedByCall() -> i32 {
    let counter = Counter.{ n = 4 };
    return Size(&counter, Find(0) orelse 1);
}

fn Moved() -> i32 {
    let item = Item.{ value = 6 };
    return Eat(item, Find(0) orelse 1);
}

// A value that is only looked at stays where it is.
fn Compared(text: str, other: ?str) -> bool { return text == (other orelse "x"); }

fn InList(first: i32) -> i32 {
    let values = [_]i32{first, Find(0) orelse 2};
    return values[Find(0) orelse 1] + values[0];
}

// A loop header runs on every pass, and so does an `orelse` in it.
fn InHeader() -> i32 {
    let mut counter = Counter.{ n = 0 };
    let mut odd = 0;
    // Find gives none for 0, so the fallback counts the passes: 1, 2, 3, 4.
    for (Find(0) orelse Next(&mut counter)) < 4 {
        if counter.n == 2 { continue; }
        odd = odd + counter.n;
    }
    return odd * 10 + counter.n;
}

fn main() -> i32 {
    if InHeader() != 44 { return 27; }
    if ReadFirst() != 6 { return 20; }
    if !Compared("x", none) { return 25; }
    if InList(5) != 7 { return 26; }
    if CallFirst() != 12 { return 21; }
    if Converted(3) != 5 { return 22; }
    if BorrowedByCall() != 5 { return 23; }
    if Moved() != 7 { return 24; }
    if Value(2) != 4 { return 1; }
    if Value(0) != 0 { return 2; }
    if InCall(1) != 6 { return 3; }
    if InCall(0) != 3 { return 4; }
    if InCall(-1) != -1 { return 5; }
    if InCondition(2) != 1 { return 6; }
    if InCondition(-3) != 2 { return 7; }
    if InCondition(-9) != 0 { return 8; }
    if Lazy(3) != 6 { return 9; }
    if Lazy(0) != 7 { return 10; }
    if Chain(none, 5) != 5 { return 11; }
    if Chain(none, none) != 9 { return 12; }
    if Chain(1, 5) != 1 { return 13; }
    if Assigned(0) != 100 { return 14; }
    if Borrowed(Item.{ value = 3 }) != 3 { return 15; }
    if Borrowed(none) != -1 { return 16; }
    return 0;
}
