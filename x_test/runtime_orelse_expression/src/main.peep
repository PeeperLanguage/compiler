struct Item { value: i32 }

fn Find(id: i32) -> ?i32 {
    if id > 0 { return id * 2; }
    return none;
}

fn Count(id: i32) -> i32 { println(id); return id; }

fn Add(a: i32, b: i32) -> i32 { return a + b; }

// `orelse` is an expression: the value inside an optional, or a fallback.
fn Value(id: i32) -> i32 { return Find(id) orelse 0; }

// The fallback may be a block that leaves.
fn InCall(id: i32) -> i32 { return Add(Find(id) orelse 1, Find(id + 1) orelse { return -1; }); }

fn InCondition(id: i32) -> i32 {
    if (Find(id) orelse 0) > 3 { return 1; } else if (Find(id + 5) orelse 0) > 3 { return 2; }
    return 0;
}

// The fallback runs only when it is needed: this prints 7 once, for id 0.
fn Lazy(id: i32) -> i32 { return Find(id) orelse Count(7); }

fn Chain(a: ?i32, b: ?i32) -> i32 { return a orelse b orelse 9; }

fn Assigned(id: i32) -> i32 {
    let mut total = 0;
    total = total + (Find(id) orelse 100);
    return total;
}

// A borrowed optional gives a reference to its value.
fn Borrowed(item: ?Item) -> i32 {
    return (&item orelse { return -1; }).value;
}

fn main() -> i32 {
    if Value(2) != 4 { return 1; }
    if Value(0) != 0 { return 2; }
    if InCall(1) != 6 { return 3; }
    if InCall(0) != 3 { return 4; }
    if InCall(-1) != -1 { return 5; }
    if InCondition(2) != 1 { return 6; }
    if InCondition(-3) != 2 { return 7; }
    if InCondition(-9) != 0 { return 8; }
    if Lazy(3) != 6 { return 9; }
    if Lazy(0) != 7 { return 10; }
    if Chain(none, 5) != 5 { return 11; }
    if Chain(none, none) != 9 { return 12; }
    if Chain(1, 5) != 1 { return 13; }
    if Assigned(0) != 100 { return 14; }
    if Borrowed(Item.{ value = 3 }) != 3 { return 15; }
    if Borrowed(none) != -1 { return 16; }
    return 0;
}
