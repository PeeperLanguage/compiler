struct Counter {
    total: i32
}

// A mismatched return inside a method points at the method's return type,
// the same way it does inside a plain function.
fn (self: &Counter) read() -> i32 {
    return true;
}

fn Plain() -> i32 {
    return "text";
}

fn main() -> i32 {
    let counter = Counter.{ total = 1 };
    return counter.read() + Plain();
}
