iface Reader {
    fn (&Self) read() -> i32

}
iface Writer {
    fn (&mut Self) write(val: i32),
    fn (&Self) readFloat() -> f32
}

struct Counter {
    value: i32,
    anotherField: f32
}

fn (self: &Counter) read() -> i32 {
    return self.value;
}
fn (self: &mut Counter) write(val: i32) {
    self.value = val;
}
fn (self: &Counter) readFloat() -> f32 {
    return self.anotherField;
}

fn Read(reader: &Reader) -> i32 {
    return reader.read();
}

fn Write(writer: &mut Writer, val: i32) {
    writer.write(val);
}

fn WriteAndRead(writer: &mut Writer, val: i32) -> f32 {
    writer.write(val);
    return writer.readFloat();
}

fn Rebind(mut value: i32) -> i32 {
    value = 9;
    return value;
}

fn main() -> i32 {
    let mut counter: Counter = .{
        value = 5,
        anotherField = 2.4
    };
    if WriteAndRead(&mut counter, 6) != 2.4f32 || counter.value != 6 || counter.anotherField != 2.4f32 {
        return 1;
    }
    if Rebind(1) != 9 {
        return 2;
    }
    Write(&mut counter, 7);
    if Read(&counter) == 7 && counter.value == 7 {
        return 0;
    }
    return counter.value;
}
