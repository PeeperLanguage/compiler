direction: right

entry: {
  main: "cmd.main"
  dispatch: "parseAndRunCommand"
  lookup: "lookupCommand"
  registry: "commandRegistry"
  error: "exitOnCommandError"

  main -> dispatch -> lookup -> registry
  registry -> error: "Handler(args) error"
}

compile: {
  compileEntry: "compileEntry"
  newContext: "driver.NewContext"
  parse: "driver.ParseFileWithOverlay"
  pipeline: "pipeline.Run"
  phases: "AST -> semantics -> HIR -> CFG -> ownership -> MIR -> LLVM [conceptual]"

  compileEntry -> newContext -> parse -> pipeline -> phases
}

build: {
  command: "buildCommand"
  args: "parseBuildArgs"
  target: "resolveBuildTarget"
  diagnostics: "emitAndCheckDiagnostics"
  artifacts: "saveIRs"
  stage: "moduleArtifactBase / replaceArtifactTree"
  executable: "buildExecutable"
  linkerArgs: "clangArgsForBuild"
  clang: "clang [external]"

  command -> args -> target -> compile.compileEntry -> diagnostics
  diagnostics -> artifacts: "-keep-gen"
  artifacts -> stage
  diagnostics -> executable -> linkerArgs -> clang
}

run: {
  command: "runCommand"
  args: "parseCommandArgs"
  target: "resolveBuildTarget"
  executable: "buildExecutable"
  process: "exec.Command [standard library]"

  command -> args -> target -> compile.compileEntry -> executable -> process
}

check: {
  command: "checkCommand"
  args: "parseCommandArgs"
  discover: "project.DiscoverSourceFiles"
  owner: "manifest.ResolveSourceFileProject"
  context: "driver.NewContext"
  roots: "driver.ParseFileWithOverlay"
  diagnostics: "emitAndCheckDiagnostics"

  command -> args -> discover -> owner -> context -> roots -> compile.pipeline -> diagnostics
}

dependencies: {
  get: "cli.GetCommand"
  update: "cli.UpdateCommand"
  remove: "cli.RemoveCommand"
  cleanup: "cli.CleanupCommand"
  state: "manifest.SaveDependencyState"
  lock: "manifest.SaveLockfile"
  cache: "deletePrunedDependencies"

  get -> state -> cache
  update -> state -> cache
  remove -> state -> cache
  cleanup -> lock -> cache
}
