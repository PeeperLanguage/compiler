direction: right

main: "cmd.main"
dispatch: "parseAndRunCommand"
registry: "commandRegistry"
handler: "registered Handler"

main -> dispatch: "os.Args"
dispatch -> registry: "lookupCommand"
registry -> handler: "func([]string) error"

handler -> build: "buildCommand / runCommand"
handler -> check: "checkCommand"
handler -> deps: "cli dependency commands"
handler -> lsp: "lspCommand"

build: {
  resolve: "resolveBuildTarget"
  compile: "compileEntry"
  driver: "compiler.ParseFileWithOverlay"
  pipeline: "pipeline.Run"
  artifacts: "saveIRs"
  link: "buildExecutable"
  clang: "clang [external]"

  resolve -> compile -> driver -> pipeline
  pipeline -> artifacts: "-keep-gen"
  pipeline -> link -> clang
}

check: {
  discover: "project.DiscoverSourceFiles"
  owner: "manifest.ResolveSourceFileProject"
  context: "compiler.NewContext"
  roots: "compiler.ParseFileWithOverlay"

  discover -> owner -> context -> roots -> pipeline
}

deps: "GetCommand / UpdateCommand / RemoveCommand / CleanupCommand"
lsp: "lsp.Run"
