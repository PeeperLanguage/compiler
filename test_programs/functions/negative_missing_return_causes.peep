//@ library

fn Touch(value: i32) {}

// A missing return is reported only when some path reaches the end of the
// function without returning. A branch that does not return is no error while
// code after it does, so the valid functions below must stay silent.

fn OuterReturn(a: i32) -> i32 {
    if a > 0 {
        Touch(a);
    }
    return 2;
}

fn NestedOuterReturn(a: i32, b: i32) -> i32 {
    if a > 0 {
        if b > 0 {
            return 1;
        }
    }
    return 3;
}

fn EveryBranchReturns(a: i32) -> i32 {
    if a > 0 {
        return 1;
    } else {
        return 2;
    }
}

fn NoResult(a: i32) {
    if a > 0 {
        return;
    }
}

// A function whose checking found an error gets no missing-return error too.
fn AlreadyWrong(a: i32) -> i32 {
    let b: bool = a; //~ error[T0001]: mismatched types: expected `bool`, found `i32`
}

// Nothing returns: the end of the function is the cause.
fn OnlyStatements(a: i32) -> i32 {
    Touch(a);
} //~ error[T0017]: not all control paths return a value
//~ label: function ends without returning `i32`

fn EmptyBody() -> i32 {
} //~ error[T0017]: not all control paths return a value

// Statements after an `if` separate it from the end, so only the end is named.
fn TailAfterIf(a: i32) -> i32 {
    if a > 0 {
        return 1;
    }
    Touch(a);
    Touch(a);
} //~ error[T0017]: not all control paths return a value

fn TailAfterBranches(a: i32) -> i32 {
    if a > 0 {
        Touch(1);
    } else {
        Touch(2);
    }
    Touch(3);
} //~ error[T0017]: not all control paths return a value

// The function ends right after the construct, so the construct is named.
fn IfWithoutElse(a: i32) -> i32 {
    if a > 0 { //~ error[T0017]: not all control paths return a value
    //~ label: if this is false, nothing is returned
    //~ help: add a `return` at the end of the function, or make each path shown return a value
        return 1;
    }
}

fn BranchEnds(a: i32) -> i32 {
    if a > 0 {
        return 1;
    } else {
        Touch(a); //~ error[T0017]: not all control paths return a value
        //~ label: this path ends without returning
    }
}

fn ElseIfWithoutElse(a: i32) -> i32 {
    if a > 0 {
        return 1;
    } else if a < 0 { //~ error[T0017]: not all control paths return a value
        return 2;
    }
}

fn NestedIf(a: i32, b: i32) -> i32 {
    if a > 0 {
        if b > 0 { //~ error[T0017]: not all control paths return a value
            return 1;
        }
    } else {
        return 2;
    }
}

fn InnerThenFalls(a: i32, b: i32) -> i32 {
    if a > 0 { //~ error[T0017]: not all control paths return a value
        if b > 0 {
            return 1;
        }
        Touch(b);
    }
}

fn TwoIfs(a: i32, b: i32) -> i32 {
    if a > 0 {
        Touch(1);
    }
    if b > 0 { //~ error[T0017]: not all control paths return a value
        Touch(2);
    }
}

fn ManyCauses(a: i32, b: i32, c: i32, d: i32) -> i32 {
    if a > 0 {
        Touch(1); //~ error[T0017]: not all control paths return a value
        //~ note: 2 more path(s) like these are not shown
    } else if b > 0 {
        Touch(2);
    } else if c > 0 {
        Touch(3);
    } else if d > 0 {
        Touch(4);
    }
}

fn ConstantCondition() -> i32 {
    if false { //~ error[T0017]: not all control paths return a value
    //~ label: this is always false, so nothing is returned
        return 1;
    }
}

// Constant conditions count both sides, so `if true` without an `else` is
// still missing a return; the label says which side the constant takes.
fn ConstantTrue() -> i32 {
    if true { //~ error[T0017]: not all control paths return a value
        return 1;
    }
}

fn ConstantTrueEmpty() -> i32 {
    if true { //~ error[T0017]: not all control paths return a value
    //~ label: this is always true, so nothing is returned
    }
}

// An empty branch has no statement to point at, so the condition is named.
fn EmptyThenAndNoElse(a: i32) -> i32 {
    if a > 0 { //~ error[T0017]: not all control paths return a value
    //~ label: either way, nothing is returned
    }
}

fn EmptyThenOnly(a: i32) -> i32 {
    if a > 0 { //~ error[T0017]: not all control paths return a value
    //~ label: if this is true, nothing is returned
    } else {
        return 1;
    }
}

fn EmptyElse(a: i32) -> i32 {
    if a > 0 { //~ error[T0017]: not all control paths return a value
        return 1;
    } else {
    }
}
