//@ run
//@ exit-code: 7

import "run_write_and_exit_code:util";

const Greeting = c"hello\tworld\n";

fn main() -> i32 {
    Write(Stdout, Greeting, 12);
    if util::Half(10) == 5 {
        Write(Stdout, c"half is 5\n", 10);
    }
    // No descriptor 7 is open: the write fails before it reads a byte, so
    // its length passes no output limit.
    if Write(7, Greeting, 2000000) == -1 {
        Write(Stdout, c"no descriptor 7\n", 16);
    }
    return 7;
}
