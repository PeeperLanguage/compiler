//@ library

// Code that no path reaches warns once, at the start of each stretch.

fn Work() {}

fn AfterReturn() -> i32 {
    return 1;
    let unused = 2; //~ warning[W0001]: unreachable code
    //~ label: this never runs
    Work();
    return unused;
}

fn AfterBothSides(ready: bool) -> i32 {
    if ready {
        return 1;
    } else {
        return 2;
    }
    Work(); //~ warning[W0001]: unreachable code
    return 3;
}

fn InEachSide(ready: bool) {
    if ready {
        return;
        Work(); //~ warning[W0001]: unreachable code
    } else {
        return;
        let later = 1; //~ warning[W0001]: unreachable code
    }
    Work();
}

fn DeadBranch(ready: bool) {
    return;
    if ready { //~ warning[W0001]: unreachable code
        Work();
    }
}

// A `for` works out its range before the name it binds; the loop warns once.
fn LoopAfterReturn() {
    return;
    for i in 0..3 { //~ warning[W0001]: unreachable code
        Work();
    }
}

// Silent: every line here can run, or is only skipped by a constant.

fn ReturnLast() {
    Work();
    return;
}

fn ReturnInside(ready: bool) -> i32 {
    if ready {
        return 1;
    }
    return 2;
}

fn ConstantCondition() {
    if false {
        Work();
    }
}

// No `return` is missing after a `panic`, and what follows it never runs.
fn AfterPanic() -> i32 {
    panic "stop";
    Work(); //~ warning[W0001]: unreachable code
}
