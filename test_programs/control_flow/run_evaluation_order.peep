//@ run

// Each part of an array literal, each value `print` writes, and the value
// an assignment sets, is taken where it is written, before a later call can
// change it.
fn bump(a: &mut [3]i32) -> i32 {
    a[0] = 100;
    return 1;
}

fn change(text: &mut &str) -> i32 {
    text.* = "after";
    return 1;
}

fn main() {
    let mut a = [3]i32{1, 2, 3};
    let spread = [4]i32{a..., bump(&mut a)};
    println(spread[0], spread[1], spread[2], spread[3]);

    let mut b = [3]i32{1, 2, 3};
    let nested = [2][3]i32{b, [3]i32{bump(&mut b), 0, 0}};
    println(nested[0][0]);

    let mut c = [3]i32{1, 2, 3};
    let mut rows = [2][3]i32{[3]i32{0, 0, 0}, [3]i32{0, 0, 0}};
    rows[bump(&mut c) as usize] = c;
    println(rows[1][0]);

    let mut text: &str = "before";
    println(text, change(&mut text));
}
