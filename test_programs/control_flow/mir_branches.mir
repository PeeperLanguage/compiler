fn pick:
  bb0:
    store i32 a.0, arg0
    %1 = load i32 a.0
    %2 = slt i32 0, %1
    branch %2, bb1, bb2
  bb1:
    store i32 late.1, 1
    jump bb3
  bb2:
    %4 = load i32 a.0
    %5 = slt i32 %4, 0
    branch %5, bb4, bb5
  bb3:
    %9 = load i32 late.1
    dead late.1
    dead a.0
    return %9
  bb4:
    dead late.1
    dead a.0
    return 2
  bb5:
    store i32 late.1, 3
    jump bb6
  bb6:
    jump bb3
  bb7:
    jump bb6
  bb8:
    dead late.1
    dead a.0
    fall off at `}`
fn quiet:
  bb0:
    store i8 flag.0, arg0
    %1 = load i8 flag.0
    branch %1, bb1, bb2
  bb1:
    dead flag.0
    return
  bb2:
    dead flag.0
    fall off at `}`
  bb3:
    jump bb2
fn main:
  bb0:
    fall off at `}`
