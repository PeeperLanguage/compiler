fn both:
  bb0:
    store i8 a.0, arg0
    store i8 b.1, arg1
    %2 = load i8 a.0
    store i8 .3, 0
    branch %2, bb1, bb2
  bb1:
    %4 = load i8 b.1
    store i8 .3, %4
    jump bb2
  bb2:
    %6 = load i8 .3
    dead .3
