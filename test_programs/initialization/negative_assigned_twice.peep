//@ library

fn Twice() -> i32 {
    let a: i32; //~ label: declared without `mut` here
    a = 1;
    a = 2; //~ error[T0007]: cannot assign twice to immutable `a`
    //~ label: `a` is already set here
    //~ help: write `let mut a` to assign it more than once
    return a;
}

fn MaybeTwice(flag: bool) -> i32 {
    let b: i32;
    if flag {
        b = 1;
    }
    b = 2; //~ error[T0007]: cannot assign twice to immutable `b`
    //~ label: `b` may already be set here
    return b;
}

// A `let` with a value is set where it is declared, so the checker rejects any
// assignment to it.
fn WithValue() -> i32 {
    let c = 1;
    c = 2; //~ error[T0007]: cannot assign to immutable `c`
    return c;
}

// A move takes the value, not the assignment: `d` is still set once.
struct Pair {
    left: i32,
    right: &i32,
}

fn Consume(pair: Pair) {}

fn MovedThenSet(n: &i32) {
    let d: Pair;
    d = Pair.{left = 1, right = n};
    Consume(d);
    d = Pair.{left = 2, right = n}; //~ error[T0007]: cannot assign twice to immutable `d`
    //~ label: `d` is already set here
    Consume(d);
}
