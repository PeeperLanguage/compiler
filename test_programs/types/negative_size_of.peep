iface Shape {
    fn Area(&self) -> i32,
}

struct Node {
    value: i32,
}

fn main() {
    let mut x: i32 = 1;
    let p = @x;
    size_of(str); //~ error[P0011]: `str` is text of any length, so it has no fixed size
    size_of(cstr); //~ error[P0011]: `cstr` is C text of any length, so it has no fixed size
    size_of(Shape); //~ error[T0043]: owned interfaces as type arguments are not supported yet
    size_of(x); //~ error[T0021]: `x` is a value, not a type
    size_of(1 + 2); //~ error[T0021]: `1 + 2` is a value, not a type
    size_of(Node, Node); //~ error[T0006]: `size_of` takes 1 argument, but 2 were given
    align_of(); //~ error[T0006]: `align_of` takes 1 argument, but 0 were given
    size_of(main); //~ error[T0021]: `main` is a value, not a type
    size_of(Missing); //~ error[T0002]: unknown type `Missing`
    let q = *Node; //~ error[T0004]: `*Node` is a type, not a value
    println(*p); //~ error[T0004]: `*p` is a type, not a value
    //~ help: write `p.*` to use the value `p` points to
    let r = rawptr + 1; //~ error[T0004]: `rawptr` is a type, not a value
    let s = [4]i32; //~ error[T0004]: `[4]i32` is a type, not a value
    *p = 5; //~ error[T0004]: `*p` is a type, not a value
}

// A call of `size_of` is the built-in's, so no function takes the name.
fn size_of(x: i32) -> i32 { //~ error[T0003]: `size_of` is a built-in function
    return x;
}

// Nor does any other declaration.
const align_of: i32 = 1; //~ error[T0003]: `align_of` is a built-in function
