//@ dump: mir

// The MIR of a slice whose start is known only when the program runs: the
// start is converted to a `usize` and checked against the length, then
// against the constant end; the slice is a borrow of its first element,
// with the length left stored after it.
fn middle(values: [4]i32, start: i32) -> i32 {
    let view = &values[start..3];
    return view[0];
}

fn main() {}

// A slice of a slice: its elements are behind it, so the borrow's place
// dereferences it before the first element; the length is read from the slice
// and even the constant start is checked against it.
fn tail(view: &[]i32) -> i32 {
    let rest = &view[1..];
    return rest[0];
}
