    %17 = sext i32 %7 to i64
    store i64 .4, %17
    %19 = address 8 .4
    call peeper_rt_v1_print_bytes(global 0, 1)
    call peeper_rt_v2_print_int(1, 1, %19)
    %22 = sext i32 %8 to i64
    store i64 .5, %22
    %24 = address 8 .5
    call peeper_rt_v1_print_bytes(global 1, 1)
    call peeper_rt_v2_print_int(1, 1, %24)
    %27 = sext i32 %9 to i64
