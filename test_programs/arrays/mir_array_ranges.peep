//@ dump: mir

// A range with run-time ends starts as `for` starts: step checked, then a
// branch on its direction; its count is checked against the elements left,
// then a loop writes each one.
fn make(n: i32, step: u32) -> [4]i32 {
    return [4]i32{9, (n..n + 6:step)...};
}

// A spread array is copied in place, all its elements in one copy.
fn join(pair: [2]i32) -> [3]i32 {
    return [3]i32{pair..., 7};
}

fn main() {
    let made = make(1, 2);
    let joined = join([2]i32{5, 6});
    println(made[0], made[1], made[2], made[3], joined[0], joined[1], joined[2]);
}
