// Only `values...` spreads: a range alone is one value, a `range[i32]`, not
// an `i32`. A spread array or slice must hold the literal's element type. A
// slice's length is known only when the program runs, so `[_]` cannot count
// it, and the values known now must not already pass the length. A spread
// reads its slice, which cannot happen while a `&mut` of it is in use.
fn count(n: i32) -> i32 {
    let a = [_]i32{1, 2, 3};
    let bare = [_]i32{0..3}; //~ error[T0001]: mismatched types: expected `i32`, found `range[i32]`
    let bytes = [_]u8{a...}; //~ error[T0001]: `...` here spreads a range, an array or a slice of `u8`, found `[3]i32`
    let number = [_]i32{n...}; //~ error[T0001]: `...` here spreads a range, an array or a slice of `i32`, found `i32`
    let short = [2]i32{a...}; //~ error[T0001]: `[2]i32` needs 2 values, found 3
    return n;
}

fn slices(s: &[]i32, f: &[]f64) {
    let inferred = [_]i32{s...}; //~ error[T0001]: a slice has a length known only when the program runs; write the length
    let floats = [2]i32{f...}; //~ error[T0001]: `...` here spreads a range, an array or a slice of `i32`, found `&[]f64`
    let past = [2]i32{1, 2, 3, s...}; //~ error[T0001]: `[2]i32` needs 2 values, found at least 3
}

fn kept(m: &mut []i32) {
    let element = &mut m[0];
    let read = [2]i32{m...}; //~ error[T0037]: `m` is borrowed while a `&mut` reference to it is still in use
    element.* = 1;
}

fn main() {
    count(1);
}
