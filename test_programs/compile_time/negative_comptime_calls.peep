// What only a run knows cannot be a constant, wherever the name is used.
fn double(x: i32) -> i32 {
    return x * 2;
}
fn unknown(given: i32) -> i32 { //~ label: `given` gets its value only when the program runs
    const K = double(given); //~ error[T0004]: the value of a constant must be known at compile time
    let later = 1; //~ label: `later` gets its value only when the program runs
    const L = later + 1; //~ error[T0004]: the value of a constant must be known at compile time
    return K + L;
}
// A known value a constant has no form for yet is told apart from those.
