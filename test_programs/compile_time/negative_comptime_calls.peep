// A call in a constant that cannot run at compile time is an error at the
// call, pointing at where it stopped.

fn half(n: i32) -> i32 {
    if n % 2 != 0 {
        panic "odd number"; //~ label: odd number
    }
    return n / 2;
}

fn divide(a: i32, b: i32) -> i32 {
    return a / b; //~ label: division by zero
}

fn forever() -> i32 {
    for { } //~ label: this ran more than 1000000 steps
}

fn noisy() -> i32 {
    println(1); //~ label: an `extern` function cannot run at compile time
    return 1;
}

fn twice(n: i32) -> i32 {
    return half(n) * 2;
}

const A = half(3); //~ error[T0044]: this call cannot be evaluated at compile time
const B = divide(1, 0); //~ error[T0044]: this call cannot be evaluated at compile time
const C = forever(); //~ error[T0044]: this call cannot be evaluated at compile time
const D = noisy(); //~ error[T0044]: this call cannot be evaluated at compile time
const E = twice(5); //~ error[T0044]: this call cannot be evaluated at compile time
// A run-time check fails at compile time too.
fn steps(step: u32) -> u32 {
    for v in 0..10:step { } //~ label: range step is zero
    return 1;
}
const Z = steps(0); //~ error[T0044]: this call cannot be evaluated at compile time
// C functions cannot run while compiling.
const W = Write(Stdout, c"x", 1); //~ error[T0044]: this call cannot be evaluated at compile time
//~ label: an `extern` function cannot run at compile time
// A constant that needs itself to be computed.
const LOOP = back(); //~ error[T0013]: `LOOP` depends on itself
fn back() -> i32 {
    return LOOP; //~ label: `back` uses `LOOP`, closing the cycle
}
fn self_call() -> i32 { //~ error[T0013]: `self_call` depends on itself
    const SELF = self_call(); //~ label: `self_call` uses `self_call`, closing the cycle
    return SELF;
}
// A cycle through another function, which the run really takes.
fn ping() -> i32 { //~ error[T0013]: `ping` depends on itself
    const P = pong(1); //~ label: `ping` uses `ping`, closing the cycle
    return P;
}
fn pong(n: i32) -> i32 {
    if n > 0 {
        return ping();
    }
    return 0;
}
// A called function with an error: only that error is reported.
fn broken() -> i32 {
    return true; //~ error[T0001]: mismatched types: expected `i32`, found `bool`
}
fn calls_broken() -> i32 {
    return broken();
}
const BAD = calls_broken();
// Only calls on constants run: this one is still an error.
fn main() {
    let n = 2;
    const F = half(n); //~ error[T0004]: the value of a constant must be known at compile time
}
// A run stops with the program's own failure, and cannot hurt the compiler.
fn outside(at: usize) -> i32 {
    let values = [3]i32{1, 2, 3};
    return values[at]; //~ label: index out of bounds: the length is 3
}
const OUTSIDE = outside(5); //~ error[T0044]: this call cannot be evaluated at compile time
