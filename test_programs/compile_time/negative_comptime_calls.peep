// What holds up a constant is named, not a value it has no need to read: an
// array's `len` is known from its type.
fn named(after_len: i32) -> i32 { //~ label: `after_len` gets its value only when the program runs
    let held = [3]i32{1, 2, 3};
    const M = double(held.len as i32) + double(after_len); //~ error[T0004]: the value of a constant must be known at compile time
    return M;
}
