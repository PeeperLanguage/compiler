const LENT_MUTABLY = &mut 5; //~ error[T0004]: a constant cannot hold a mutable reference, as all its uses would share one value
// An address can be used, but only the running program knows one, so what
// would read it stops the run.
fn same_pointer(p: *i32) -> *i32 {
    return p;
}
fn gives_pointer() -> *i32 {
    let mut n = 1;
    return same_pointer(@n); //~ label: an address is known only when the program runs
}
const POINTER = gives_pointer(); //~ error[T0044]: this call cannot be evaluated at compile time
fn compares_addresses() -> bool {
    let mut a = 1;
