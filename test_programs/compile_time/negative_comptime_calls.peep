    let values = [3]i32{1, 2, 3};
    let view: &[]i32 = &values;
    return view[at]; //~ label: index out of bounds of the slice
}
const OUTSIDE_SLICE = outside_slice(5); //~ error[T0044]: this call cannot be evaluated at compile time
