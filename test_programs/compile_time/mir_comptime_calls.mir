fn cube:
  bb0:
    store i64 n.0, arg0
    %1 = load i64 n.0
    %2 = load i64 n.0
    %3 = mul i64 %1, %2
    %4 = load i64 n.0
    %5 = mul i64 %3, %4
    dead n.0
    return %5
  bb1:
    dead n.0
    fall off at `}`
fn text:
  bb0:
    store ptr result, global 0
    store i64 result[+8], 5
    return
  bb1:
    fall off at `}`
  global 0 = "ab\x00cd"
fn main:
  bb0:
    store i64 .0, 1000000001
    %1 = address 8 .0
    call PrintInt(1, 1, %1) in C (register, register, register)
    dead .0
    call PrintText(global 0) in C (register)
    store ptr .1, global 1
    store i64 .1[+8], 5
    %7 = load ptr .1[+0]
    %8 = load i64 .1[+8]
    call PrintBytes(%7, %8) in C (register, register)
    call PrintText(global 2) in C (register)
    call Flush() in C ()
    dead .1
    fall off at `}`
  global 0 = " \x00"
  global 1 = "ab\x00cd"
  global 2 = "\n\x00"
