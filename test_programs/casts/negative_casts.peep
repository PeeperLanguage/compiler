// Casts `as` rejects, and conversions that need `as`.
struct Point { x: i32, y: i32 }

fn convert(big: i32, wide: f64, flag: bool, count: &i32) {
    let p = Point.{ x = 1, y = 2 };
    let a = p as i32; //~ error[T0014]: `Point` cannot be converted to `i32`
    let b = count as &mut i32; //~ error[T0014]: `&i32` cannot be converted to `&mut i32`
    let c = big as bool; //~ error[T0014]: `i32` cannot be converted to `bool`
    let d = flag as f64; //~ error[T0014]: `bool` cannot be converted to `f64`
    let e = 300 as u8; //~ error[L0003]: literal `300` does not fit `u8`
    let f = count as i64; //~ error[T0014]: `&i32` cannot be converted to `i64`
    //~ fixed: let f = count.* as i64;
    let small: u8 = big; //~ error[T0001]: mismatched types: expected `u8`, found `i32`
    //~ help: add `as u8` to convert, which can change the value
    //~ fixed: let small: u8 = big as u8;
    let single: f32 = wide + 1.0; //~ error[T0001]: mismatched types: expected `f32`, found `f64`
    //~ fixed: let single: f32 = (wide + 1.0) as f32;
}

fn main() {}
