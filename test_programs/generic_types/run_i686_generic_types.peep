//@ run
//@ target: i686-linux

// A generic struct, `Box<T>`: each list of types it is given makes its own
// copy of the struct, with its own fields and layout.

struct Box<T> {
    value: T,
}

struct Pair<A, B> {
    first: A,
    second: B,
}

// A copy points to another of its kind: a pointer only names it.
struct Node<T> {
    value: T,
    next: *Node<T>,
}

fn Unwrap(b: Box<i32>) -> i32 {
    return b.value;
}

// A generic function names a copy with its own `T`.
fn Nest<T>(value: T) -> Box<Box<T>> {
    let made: Box<Box<T>> = .{ value = .{ value = value } };
    return made;
}

fn main() {
    // The type comes from where the value goes, or is written after `::`.
    let a: Box<i32> = .{ value = 1 };
    let b = Box::<f64>.{ value = 2.5 };
    let nested: Box<Box<u8>> = .{ value = .{ value = 7 } };
    let pair: Pair<bool, i64> = .{ first = true, second = 9 };
    println(a.value, b.value, nested.value.value, pair.first, pair.second);
    // In an expression, a type with arguments is written after `::`.
    println(size_of(Box::<u8>), size_of(Box::<i64>), size_of(Node::<u8>));
    let mut last: Node<i32> = .{ value = 2, next = none };
    let first: Node<i32> = .{ value = 1, next = @last };
    println(first.value + first.next.*.value, Unwrap(a), Nest::<i8>(6).value.value);
}
