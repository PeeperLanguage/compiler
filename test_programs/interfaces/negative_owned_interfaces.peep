// What the checks refuse for owned interfaces: one cannot outlive the
// struct it took, a struct or interface moved away is gone, a change
// through one needs `mut` and no other loan of it in use, and a struct or
// array holding one follows the rules of any loan holder.
iface Shape {
    fn area(&self) -> i32,
    fn grow(&mut self, by: i32),
    fn retire(self) -> i32
}

struct Square { side: i32 }
fn Square::area(&self) -> i32 { return self.side * self.side; }
fn Square::grow(&mut self, by: i32) { self.side = self.side + by; }
fn Square::retire(self) -> i32 { return self.side; }

fn escapes() -> Shape { //~ error[T0016]: a `Shape` result needs a parameter to come from: a struct the function moves into it is gone once it returns
    let s: Shape = Square.{ side = 2 };
    return s;
}

fn replaced(given: Shape) -> Shape {
    let made: Shape = Square.{ side = 1 };
    return made; //~ error[T0036]: returns an interface holding a temporary value, which is gone once the function returns
}

fn taken() {
    let square = Square.{ side = 2 };
    let s: Shape = square;
    println(square.side, s.area()); //~ error[T0034]: `square` is used after it was moved
}

fn retired() {
    let s: Shape = Square.{ side = 2 };
    println(s.retire(), s.area()); //~ error[T0034]: `s` is used after it was moved
}

fn fixed() {
    let s: Shape = Square.{ side = 2 };
    s.grow(1); //~ error[T0007]: cannot mutably borrow immutable `s`
}

fn lent() {
    let mut s: Shape = Square.{ side = 2 };
    let view = &s;
    println(s.retire(), view.area()); //~ error[T0037]: `s` is moved while a reference to it is still in use
}

fn through_reference() {
    let mut s: Shape = Square.{ side = 2 };
    let edit = &mut s;
    println(edit.retire()); //~ error[T0004]: `retire` takes `self` whole, so it cannot be called through `&Shape`
}

fn main() {
    replaced(Square.{ side = 3 });
    taken();
    retired();
    fixed();
    lent();
    through_reference();
}

// A struct lasts as long as the variable that first holds it: moved out of
// its block, it is gone; changed while an older interface views it, that
// one would see the new struct.
fn moved_out() {
    let mut keep: Shape = Square.{ side = 0 };
    for side in 0..3 {
        let each: Shape = Square.{ side = side };
        keep = each;
    } //~ error[T0037]: a temporary value is gone while a `&mut` reference to it is still in use
    println(keep.area());
}

fn overwritten() {
    let mut keep: Shape = Square.{ side = 1 };
    for side in 0..3 {
        let old = keep;
        keep = Square.{ side = side }; //~ error[T0037]: a temporary value is changed while a `&mut` reference to it is still in use
        println(old.area());
    }
}

// A struct or array holding a `Shape` follows the same rules as one holding
// any loan.
struct Holder { shape: Shape }

fn held() -> Holder { //~ error[T0016]: a result holding references needs a parameter that holds one
    return Holder.{ shape = Square.{ side = 1 } };
}

fn field_moved_out() {
    let h = Holder.{ shape = Square.{ side = 1 } };
    println(h.shape.retire()); //~ error[T0035]: cannot move a field out of its struct
}

fn element_moved_out() {
    let all = [2]Shape{Square.{ side = 1 }, Square.{ side = 2 }};
    let first = all[0]; //~ error[T0035]: cannot move an element out of its array
}

fn set_through(h: &mut Holder) {
    h.shape = Square.{ side = 2 }; //~ error[T0043]: assignments of references through a reference are not supported yet
}

fn each_pass() {
    let mut all = [2]Shape{Square.{ side = 1 }, Square.{ side = 2 }};
    for i in 0..2 {
        all[i] = Square.{ side = i }; //~ error[T0037]: a temporary value is changed while a `&mut` reference to it is still in use
    }
    println(all[0].area());
}
