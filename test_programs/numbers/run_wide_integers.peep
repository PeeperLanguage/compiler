//@ run

// Integers wider than 128 bits as parameters, results, loop values, memory
// and range counters, at compile time (the constants) and when the program
// runs. Their constants are kept as read-only data, so `-x`, `~x`, a zero
// test before `/` and a range's counter each read a real value.
fn neg(x: i256) -> i256 { return -x; }
fn not(x: u256) -> u256 { return ~x; }
fn div(x: i256, y: i256) -> i256 { return x / y; }

fn add(a: i256, b: i256) -> i256 { return a + b; }
fn sum_to(n: i200) -> i200 {
    let mut total: i200 = 0;
    let mut i: i200 = 0;
    for i < n {
        total = add(total as i256, i as i256 * 1000000000000000000000000000000000000000) as i200;
        i = i + 1;
    }
    return total;
}

// Each call's wide values stay its own while deeper calls run.
fn down(n: u300, acc: u300) -> u300 {
    if n == 0 { return acc; }
    let kept = acc * 3 + n;
    let deeper = down(n - 1, kept);
    return deeper + kept - kept;
}

fn mix(a: i256, x: i32, b: i256) -> i256 {
    let mut parts = [3]i256{a, b, a - b};
    parts[1] = parts[0] * parts[2];
    return parts[1] + x as i256;
}

fn weighted(a: i256, b: i256) -> i256 {
    let mut t: i256 = 0;
    for i, v in a..=b { t = t + v * (i as i256); }
    return t;
}

fn falling(a: u130, b: u130) -> u130 {
    let mut t: u130 = 0;
    for v in a..b { t = t + v; }
    return t;
}

// A `u128` range is counted in 129 bits, then placed at a `usize` index.
fn spread(n: u128) -> [4]u128 { return [4]u128{(0u128..n)..., 9}; }

const N = neg(5);
const B = not(0);
const Q = div(100, 100);
const S = sum_to(50);
const D = down(40, 1);
const M = mix(-123456789012345678901234567890123456789, 7, 98765432109876543210987654321098765432);
const W = weighted(-3, 4);
const F = falling(20, 3);

fn main() {
    println("const:", N, B, Q, S, D, M, W, F);
    println("run:", neg(5), not(0), div(100, 100), sum_to(50), down(40, 1),
        mix(-123456789012345678901234567890123456789, 7, 98765432109876543210987654321098765432),
        weighted(-3, 4), falling(20, 3));
    let s = spread(3);
    println("spread:", s[0], s[1], s[2], s[3]);
    let big: i256 = -1;
    println("casts:", big as u256, (big as u256) >> 200, big as i8 as i256);
    // A `u200` is kept in 25 bytes: those after it in its 32-byte slot stay.
    let mut bytes = [32]u8{(0..32)...};
    let wide = @bytes as *u200;
    wide.* = 1;
    println("store:", bytes[0], bytes[24], bytes[25], bytes[31]);
}
