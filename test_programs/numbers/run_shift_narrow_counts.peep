//@ run

// A shift count of a type too narrow to reach the width is outside it only
// when negative; one of a type that reaches it is checked against it.
fn main() {
    let small: i5 = 2;
    let x: i32 = 8;
    println("i5:", x << small, x >> small);
    let one: i8 = 1;
    let wide: u256 = 8;
    println("i8:", wide << one);
    let reaching: i7 = 2;
    println("i7:", x << reaching);
}
