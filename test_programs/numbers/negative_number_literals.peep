// Letters or digits right after a number make one bad number, not a number
// followed by a name.
fn main() {
    let a = 1abc; //~ error[L0003]: invalid number literal 1abc
    let b = 06_raw; //~ error[L0003]: invalid number literal 06_raw
    let c = 5u8x; //~ error[L0003]: invalid number literal 5u8x
    let d = 0xFG; //~ error[L0003]: invalid hexadecimal literal 0xFG
}
