// An unknown type gets a guess among built-in and declared types; an
// unknown name in a module, among the names that module exports; an unknown
// name, among the names in scope, the prelude's exported ones included.
import "negative_suggest_type_and_member:shapes";

struct Point {
    x: i32,
}

fn main() {
    let point: Pont; //~ error[T0002]: unknown type `Pont`
    //~ help: did you mean `Point`?
    let flag: boool = true; //~ error[T0002]: unknown type `boool`
    //~ help: did you mean `bool`?
    shapes::Perimter(); //~ error[T0002]: unknown name `Perimter` in module `shapes`
    //~ help: did you mean `Perimeter`?
    exit(0); //~ error[T0002]: unknown name `exit`
    //~ help: did you mean `Exit`?
}
