//@ library
//@ target: i686-linux

// Loans on a 32-bit target, where a pointer is 4 bytes: two references
// side by side are held apart, and a slice's length, 4 bytes after its
// pointer, is apart from its elements.
struct Two { first: &i32, second: &i32 }

// `two.first` holds `y`'s loan, `two.second` only `z`'s.
fn SideBySide() -> i32 {
    let mut y = 2;
    let z = 3;
    let mut two = Two.{ first = &z, second = &z };
    two.first = &y;
    y = 4;
    return two.second.*;
}

fn LengthAfterChange() {
    let mut values = [3]i32{1, 2, 3};
    let view = &mut values[..];
    values[0] = 1;
    println(view.len);
}

fn BeforeSliceStart() -> i32 {
    let mut values = [3]i32{1, 2, 3};
    let tail = &mut values[1..];
    values[0] = 9;
    tail[0] = 4;
    return values[0];
}
