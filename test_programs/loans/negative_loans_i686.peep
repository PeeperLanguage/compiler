//@ library
//@ target: i686-linux

// Loans on a 32-bit target, where a pointer is 4 bytes: repointing
// `two.first` leaves the loan `two.second` holds, 4 bytes on.
struct Two { first: &i32, second: &i32 }

fn SecondKeepsItsLoan() -> i32 {
    let mut y = 2;
    let z = 3;
    let mut two = Two.{ first = &y, second = &y };
    two.first = &z;
    y = 4; //~ error[T0037]: `y` is changed while a reference to it is still in use
    return two.second.*;
}
