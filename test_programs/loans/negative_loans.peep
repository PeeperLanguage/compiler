//@ library

// Each access a reference still in use forbids: one error per function.
struct Pair { left: i32, right: i32 }

fn read(n: &i32) -> i32 {
    return n.*;
}

fn both(a: &mut i32, b: &i32) {}

fn twice(a: &mut i32, b: &mut i32) {}

fn take(n: &mut i32, flag: bool) {}

fn bump(n: &mut i32) -> i32 {
    return 1;
}

fn consume(a: &mut Pair, b: Pair) {}

fn WriteUnderShared() -> i32 {
    let mut x = 1;
    let r = &x; //~ label: reference made here
    x = 2; //~ error[T0037]: `x` is changed while a reference to it is still in use
    return read(r); //~ label: reference used later here
}

fn MoveUnderShared() -> i32 {
    let p = Pair.{ left = 1, right = 2 };
    let r = &p;
    let moved = p; //~ error[T0037]: `p` is moved while a reference to it is still in use
    return r.left;
}

fn MutableUnderShared() -> i32 {
    let mut x = 1;
    let r = &x;
    let m = &mut x; //~ error[T0037]: `x` is borrowed as `&mut` while a reference to it is still in use
    return read(r);
}

fn ReadUnderMutable() -> i32 {
    let mut x = 1;
    let m = &mut x;
    let copy = x; //~ error[T0037]: `x` is read while a `&mut` reference to it is still in use
    m.* = 2;
    return copy;
}

fn WriteUnderMutable() {
    let mut x = 1;
    let m = &mut x;
    x = 2; //~ error[T0037]: `x` is changed while a `&mut` reference to it is still in use
    m.* = 3;
}

fn SharedUnderMutable() -> i32 {
    let mut x = 1;
    let m = &mut x;
    let r = &x; //~ error[T0037]: `x` is borrowed while a `&mut` reference to it is still in use
    m.* = 2;
    return read(r);
}

// The same field, and the whole struct, overlap the borrowed field.
fn SameField() {
    let mut pair = Pair.{ left = 1, right = 2 };
    let left = &mut pair.left;
    pair.left = 3; //~ error[T0037]: `pair` is changed while a `&mut` reference to it is still in use
    left.* = 4;
}

// A borrow made on one side of an `if` is still in use after it.
fn BorrowInBranch(flag: bool) -> i32 {
    let a = 1;
    let mut x = 2;
    let mut r = &a;
    if flag {
        r = &x;
    }
    x = 3; //~ error[T0037]: `x` is changed while a reference to it is still in use
    return read(r);
}

// A reference made through `r` keeps `x` borrowed while it is in use.
fn ReborrowKeepsBorrow() {
    let mut x = 1;
    let r = &mut x;
    let s = &mut r.*;
    x = 2; //~ error[T0037]: `x` is changed while a `&mut` reference to it is still in use
    s.* = 3;
}

// `x` ends with its block while `r` still refers to it.
fn OutlivesScope() -> i32 {
    let r: &i32;
    {
        let x = 1;
        r = &x;
    } //~ error[T0037]: `x` is gone while a reference to it is still in use
    //~ label: gone here
    return read(r);
}

// When the call starts, `&x`, passed to the same call, is still in use.
fn SameCall() {
    let mut x = 1;
    both(&mut x, &x); //~ error[T0037]: `x` is borrowed as `&mut` while a reference to it is still in use
    //~ note: a `&mut` argument takes hold when the call starts
}

fn SameCallTwice() {
    let mut x = 1;
    twice(&mut x, &mut x); //~ error[T0037]: `x` is borrowed as `&mut` while a `&mut` reference to it is still in use
}

// The `&mut x` for `bump` takes hold while the one for `take` is reserved.
fn NestedMutable() {
    let mut x = 1;
    take(&mut x, bump(&mut x) > 0); //~ error[T0037]: `x` is borrowed as `&mut` while a `&mut` reference to it is still in use
}

// `r` is still in use after the call, so `&mut x` cannot take hold.
fn SharedBeforeCall() -> i32 {
    let mut x = 1;
    let r = &x;
    take(&mut x, true); //~ error[T0037]: `x` is borrowed as `&mut` while a reference to it is still in use
    return read(r);
}

// Moving `p` while its `&mut` argument is reserved.
fn MovedArgument() {
    let mut p = Pair.{ left = 1, right = 2 };
    consume(&mut p, p); //~ error[T0037]: `p` is moved while a `&mut` reference to it is still in use
}

// A `&mut` used as a `&` holds `m` like a `&`: no change through `m` while
// `r` is in use.
fn ChangedThroughMutable() -> i32 {
    let mut x = 1;
    let m = &mut x;
    let r: &i32 = m;
    m.* = 2; //~ error[T0037]: `m` is changed while a reference to it is still in use
    return read(r);
}

// `s` still refers to `a` after `r` points to `b`.
fn ChangedAfterRepoint() -> i32 {
    let mut a = 1;
    let mut b = 2;
    let mut r = &mut a;
    let s = &mut r.*;
    r = &mut b;
    a = 5; //~ error[T0037]: `a` is changed while a `&mut` reference to it is still in use
    s.* = 3;
    return b;
}

// `r` points somewhere else on one path only, so `r.*` may still be what
// `s` refers to.
fn RepointOnOnePath(flag: bool) -> i32 {
    let mut a = 1;
    let mut b = 2;
    let mut r = &mut a;
    let s = &mut r.*;
    if flag {
        r = &mut b;
    }
    r.* = 4; //~ error[T0037]: `r` is changed while a `&mut` reference to it is still in use
    s.* = 3;
    return b;
}
