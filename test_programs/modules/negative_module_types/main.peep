// A path in a type finds what a path in a value finds, with the same errors.
import "negative_module_types:geometry";
import "negative_module_types:other";

fn main() {
    let a: geometry::hidden = geometry::Origin(); //~ error[M0004]: `hidden` is not exported from `geometry`
    let b: geometry::Origin = geometry::Origin(); //~ error[T0021]: `geometry::Origin` is a value, not a type
    let c: geometry = geometry::Origin(); //~ error[T0021]: `geometry` is a module, not a type
    let d: geometry::Pont = geometry::Origin(); //~ error[T0002]: unknown name `Pont` in module `geometry`
    //~ help: did you mean `Point`?
    let e: geometri::Point = geometry::Origin(); //~ error[T0002]: unknown name `geometri`
    //~ help: did you mean `geometry`?
    // Each module's `Point` is its own type.
    let f: geometry::Point = other::Point.{ x = 1 }; //~ error[T0001]: mismatched types: expected `negative_module_types:geometry::Point`, found `negative_module_types:other::Point`
    let g: [1]geometry::Point = [1]other::Point{ .{ x = 1 } }; //~ error[T0001]: mismatched types: expected `[1]negative_module_types:geometry::Point`, found `[1]negative_module_types:other::Point`
    let h = geometry::Origin() as other::Point; //~ error[T0014]: `negative_module_types:geometry::Point` cannot be converted to `negative_module_types:other::Point`
    let items = [1]other::Point{ .{ x = 1 } };
    let i = [1]geometry::Point{ items... }; //~ error[T0001]: `...` here spreads a range, an array or a slice of `negative_module_types:geometry::Point`, found `[1]negative_module_types:other::Point`
    let held = other::Point.{ x = 1 };
    let j: geometry::Point = &held; //~ error[T0001]: mismatched types: expected `negative_module_types:geometry::Point`, found `&negative_module_types:other::Point`
    // One `Point` needs no module to tell it from itself.
    let own = geometry::Origin();
    let k: geometry::Point = &own; //~ error[T0001]: mismatched types: expected `Point`, found `&Point`
    let l = &mut geometry::Sides; //~ error[T0018]: cannot mutably borrow constant `geometry::Sides`
    // A path names what a plain name names, with the same errors.
    geometry::Sides = 5; //~ error[T0018]: cannot assign to constant `geometry::Sides`
    geometry::Origin = 5; //~ error[T0007]: cannot assign to `geometry::Origin`, which is not a variable
}
