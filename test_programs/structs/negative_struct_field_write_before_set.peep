// A field is set only in a struct that is already set on every path: the
// fields of a struct are not set one by one.
struct Point { x: i32, y: i32 }

fn main() {
    let mut q: Point;
    q.y = 1; //~ error[T0039]: cannot set a field of `q` before `q` is set
    //~ label: `q` is not set yet here
    let mut s: Point;
    if true {
        s = Point.{ x = 1, y = 2 };
    }
    s.x = 2; //~ error[T0039]: cannot set a field of `s` before `s` is set
    //~ label: `s` is not set on every path to here
}
