//@ dump: ll

// LLVM keeps a struct as bytes in memory, `[size x i8]` with its alignment;
// a literal stores each field at its `getelementptr` offset, in written order,
// right where it goes when that place is new; a field read is a
// `getelementptr` and a load; debug info is a `DICompositeType` with each
// member at its offset.
struct Point {
    x: i32,
    y: i32,
}

struct Segment {
    start: Point,
    end: Point,
}

fn main() {
    let p = Point.{ y = 2, x = 1 };
    let s = Segment.{ start = p, end = .{ x = 3, y = 4 } };
    let x = s.end.x;
    let y = Point.{ x = 5, y = 6 }.y;
}
