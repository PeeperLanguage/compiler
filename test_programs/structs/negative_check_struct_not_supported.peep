// C functions do not take or give structs until the C ABI's struct rules are
// written; generic structs and enums come later.
struct Point {
    x: i32,
}

type Place = Point;

struct Pair<T> { //~ error[T0043]: generic types are not supported yet
    first: T,
}

enum Shape { //~ error[T0043]: enum declarations are not supported yet
    Circle,
}

// A field may hold an enum: its declaration is what is not supported.
struct Drawing {
    shape: Shape,
}

#[extern("take")]
fn take(point: Point); //~ error[T0043]: struct, array, range, slice and `&str` parameters and results of `extern` functions are not supported yet

#[extern("give")]
fn give() -> Place; //~ error[T0043]: struct, array, range, slice and `&str` parameters and results of `extern` functions are not supported yet

fn main() {}
