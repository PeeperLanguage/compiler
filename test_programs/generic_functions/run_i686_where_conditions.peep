//@ run
//@ target: i686-linux

// `where`: what the types and `const` values a call gives must satisfy,
// worked out when compiling, for each call. `T: Shape` asks that `T`
// implements the interface `Shape`; `T: Sized(8)` that `Sized(T, 8)` is
// `true`.

iface Shape {
    fn area(&self) -> i32,
}

struct Square {
    side: i32,
}

fn Square::area(&self) -> i32 {
    return self.side * self.side;
}

fn Number(const T: type) -> bool {
    return is_int(T) || is_float(T);
}

// As wide as an address on the machine the program is built for.
fn AddressWide(const T: type) -> bool {
    return size_of(T) == size_of(usize);
}

fn Max<T>(a: T, b: T) -> T
where
    T: Number
{
    if a > b {
        return a;
    }
    return b;
}

// What the compiler answers about a type is asked as any function is.
fn Whole<T>(value: T) -> T
where
    T: is_int
{
    return value;
}

// Each type parameter is asked about on its own.
fn Second<T, U>(first: T, second: U) -> U
where
    T: is_int,
    U: Number
{
    return second;
}

fn Wide<T>(value: T) -> usize
where
    T: AddressWide
{
    return size_of(T);
}

// A function asked may take more than the type, written after it.
fn Sized(const T: type, const N: usize) -> bool {
    return size_of(T) == N;
}

fn Eight<T>(value: T) -> T
where
    T: Sized(8)
{
    return value;
}

fn Area<T>(shape: &T) -> i32
where
    T: Shape
{
    return shape.area();
}

// A `const` value is known when compiling too.
fn Positive(const N: i32) -> bool {
    return N > 0;
}

fn Times<T>(const N: i32, value: T) -> T
where
    N: Positive
{
    let mut total = value;
    for i in 1..N {
        total = total + value;
    }
    return total;
}

fn main() {
    let small: u8 = 4;
    let address: usize = 1;
    println(Max(3, 7), Max(1.5, 0.5), Whole(small), Second(1, 2.5), Wide(address));
    println(Eight(2.5), Times(3, 7), Area(&Square.{ side = 3 }));
}
