iface Shape {
    fn Area(&self) -> i32,
}

struct Square {
    side: i32,
}

fn Square::Area(&self) -> i32 {
    return self.side;
}

fn Id<T>(value: T) -> T {
    return value;
}

fn Read<T>(place: &T) -> T {
    return place.*;
}

fn Both<T>(first: T, second: T) -> T {
    return first;
}

// No parameter's type names `T`.
fn Make<T>() -> i32 {
    return 1;
}

// Checked for each copy: this one is of a type that cannot be added.
fn Add<T>(a: T, b: T) -> T {
    return a + b; //~ error[T0004]: operator `+` cannot be applied to `bool`
}

fn Total(values: ...i32) -> i32 {
    return 0;
}

// Never called: what is wrong whatever `T` is, is still reported. What
// some copy accepts, each copy decides.
fn WrongForEvery<T>(pair: [2]T, value: T, pointer: *T, list: &[]T, values: range[T]) {
    let negated = -pair; //~ error[T0004]: operator `-` cannot be applied to `[2]T`
    let flag: bool = pair; //~ error[T0001]: mismatched types: expected `bool`, found `[2]T`
    pair.Area(); //~ error[T0004]: `[2]T` has no functions
    let shape: &Shape = &pair; //~ error[T0001]: mismatched types: expected `&Shape`, found `&[2]T`
    print(pair); //~ error[T0004]: `[2]T` cannot be printed
    let elements: &[]i32 = &pair;
    let held: &Shape = &value;
    for each in &value {}
    for each in pair {}
    let raw: *i32 = pointer;
    let spread = [_]i32{ pair... };
    // How many values `value...` gives, each copy counts.
    let counted = [_]i32{ 1, value... };
    let written = [3]i32{ value... };
    let total = Total(value...);
    let more = Total(1, value...);
    let sliced = [4]i32{ list... };
    let ranged = [4]i32{ values... };
    let full = [2]i32{ 1, 2, 3, value... }; //~ error[T0001]: `[2]i32` needs 2 values, found at least 3
    let mixed = [_]i32{ elements..., value... }; //~ error[T0001]: a slice has a length known only when the program runs; write the length
    print(value, -value, value + value);
}

#[extern("outside")]
fn Outside<T>(value: T); //~ error[P0005]: an `extern` function takes no type or `const` parameter: C gives one function for every call

fn Width(const T: type) -> usize {
    return size_of(T);
}

// A constant reading what only a run knows is wrong whatever `T` is, so the
// own check reports it, with no call.
fn RunTime<T>(value: T, n: usize) -> usize { //~ label: `n` gets its value only when the program runs
    const Y: usize = size_of(T) + n; //~ error[T0004]: the value of a constant must be known at compile time
    return Y;
}

fn main() {
    Make(); //~ error[T0004]: the arguments of `Make` do not say what its `T` is: write it at the call, `Make::<...>(...)`
    Id::<i32, f64>(1); //~ error[T0006]: `Id` takes 1 type argument, but 2 were given
    Square::Area::<i32>(&Square.{ side = 1 }); //~ error[T0006]: `Square::Area` takes no type arguments
    // A `const T: type` is given as an argument, not after `::`.
    Width::<i32>(i32); //~ error[T0006]: `Width` takes no type arguments
    Id::<bool>(1); //~ error[T0001]: mismatched types: expected `bool`, found `i32`
    Read(5); //~ error[T0004]: the arguments of `Read` do not say what its `T` is
    Both(1, true); //~ error[T0001]: mismatched types: expected `i32`, found `bool`
    Id(missing); //~ error[T0002]: unknown name `missing`
    Id(); //~ error[T0006]: `Id` takes 1 argument, but 0 were given
    Id(1, 2); //~ error[T0006]: `Id` takes 1 argument, but 2 were given
    Add(true, false);
    let wide: f64 = Id(1); //~ error[T0001]: mismatched types: expected `f64`, found `i32`
    let shape: Shape = Square.{ side = 1 };
    Id(Nothing()); //~ error[T0004]: this expression has no value to pass
    Id(shape); //~ error[T0043]: owned interfaces as type arguments are not supported yet
}

fn Twice<T, T>(value: T) -> T { //~ error[T0003]: `T` is already declared in this function
    return value;
}

// A `const T: type` is a type of the function too.
fn Named<T>(const T: type, value: T) -> T { //~ error[T0003]: `T` is already declared in this function
    return value;
}

fn Nothing() {}

struct Pair {
    left: i32,
}

// No call copies it, so its `T` is no one type: what is of that type is
// not known and reports nothing, and the rest is checked as written.
fn Uncalled<T>(const COUNT: usize, value: T, pair: Pair) -> T {
    let kept = value;
    let doubled = kept + kept;
    if is_pointer(T) {
        println(value as rawptr == none, COUNT + 1);
    }
    absent(); //~ error[T0002]: unknown name `absent`
    println(pair.right); //~ error[T0010]: `Pair` has no field `right`
    return doubled;
}

fn Double(value: i32) -> i32 {
    return value * 2;
}

fn Same(const K: i32) -> i32 {
    return K;
}

// Never called: a `const` parameter's value is each copy's, but its type is
// known, so what is wrong for that type is reported.
fn WrongForEveryCount(const N: i32) {
    let flag: bool = N; //~ error[T0001]: mismatched types: expected `bool`, found `i32`
    const TWICE: i32 = N * 2;
    let twice: bool = TWICE; //~ error[T0001]: mismatched types: expected `bool`, found `i32`
    const RUN: i32 = Double(N);
    let ran: bool = RUN; //~ error[T0001]: mismatched types: expected `bool`, found `i32`
    const ABOVE: bool = N > 2;
    let above: i32 = ABOVE; //~ error[T0001]: mismatched types: expected `i32`, found `bool`
    // Given to another `const` parameter, it makes no copy of `Same`.
    const PASSED: i32 = Same(N);
    let passed: bool = PASSED; //~ error[T0001]: mismatched types: expected `bool`, found `i32`
    let returned: bool = Same(N * 2); //~ error[T0001]: mismatched types: expected `bool`, found `i32`
}

// A spread each copy counts gives an array of `i32`s whose length only each
// copy knows: what does not depend on the length is checked once, here.
fn SpreadInto<T>(x: T) -> i32 {
    let a = [_]i32{1, x...};
    let first: bool = a[0]; //~ error[T0001]: mismatched types: expected `bool`, found `i32`
    let wrong: [3]bool = a; //~ error[T0001]: mismatched types: expected `[3]bool`, found `[_]i32`
    for value in a {
        let flag: bool = value; //~ error[T0001]: mismatched types: expected `bool`, found `i32`
    }
    let view: &[]i32 = &a;
    let three: [3]i32 = a;
    const LENGTH: usize = a.len;
    return view[0] + three[0];
}
