//@ target: aarch64-linux

// An `extern` function is C's: it has no body here, and its integers are
// ones C has on the target, at most 128 bits on AArch64. Any other function
// has a body.
#[extern("twice")]
fn twice(value: i32) -> i32 { //~ error[P0005]: an `extern` function has no body: C gives its code
    return value * 2;
}

#[extern("widest")]
fn widest(value: i128) -> i128;

#[extern("too_wide")]
fn too_wide(value: i129); //~ error[P0011]: C has no `i129` on aarch64-linux, whose integers have at most 128 bits

fn missing(value: i32) -> i32; //~ error[P0005]: a function needs a body, or `#[extern("name")]` when C defines it

fn main() {}
