fn walk:
  bb0:
    store i32 from.0, arg0
    store i32 to.1, arg1
    store i32 step.2, arg2
    store i64 last.3, 0
    %4 = load i32 from.0
    %5 = load i32 to.1
    %6 = load i32 step.2
    %7 = eq i32 %6, 0
    check %7, "range step is zero"
    %9 = sle i32 %4, %5
    branch %9, bb1, bb2
  bb1:
    %10 = sub i32 %5, %4
    store i32 .6, %10
    store i32 .7, %6
    jump bb3
  bb2:
    %13 = sub i32 %4, %5
    store i32 .6, %13
    %15 = sub i32 0, %6
    store i32 .7, %15
    jump bb3
  bb3:
    %17 = load i32 .6
    %18 = load i32 .7
    %19 = ne i32 %17, 0
    store i32 .8, %4
    store i32 .9, %17
    store i8 .10, %19
    store i64 .11, 0
    jump bb4
  bb4:
    %24 = load i8 .10
    branch %24, bb5, bb6
  bb5:
    %25 = load i32 .8
    %26 = load i32 .9
    store i32 v.5, %25
    %28 = load i64 .11
    store i64 i.4, %28
    %30 = add i64 %28, 1
    store i64 .11, %30
    %32 = ult i32 %6, %26
    %33 = add i32 %25, %18
    %34 = sub i32 %26, %6
    store i32 .8, %33
    store i32 .9, %34
    store i8 .10, %32
    %38 = load i64 i.4
    store i64 last.3, %38
    dead i.4
    dead v.5
    jump bb7
  bb6:
    dead .11
    dead .10
    dead .9
    dead .8
    dead .7
    dead .6
    %48 = load i64 last.3
    dead last.3
    dead step.2
    dead to.1
    dead from.0
    return %48
  bb7:
    jump bb4
  bb8:
    dead last.3
    dead step.2
    dead to.1
    dead from.0
    fall off at `}`
fn main:
  bb0:
    fall off at `}`
