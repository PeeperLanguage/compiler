// A `&mut` moves when a `let` takes it, so the first variable is unusable; a
// struct cannot be moved out of what a reference or raw pointer points to,
// also in a function whose only variable, a reference, copies; and a variable
// must be set before it is borrowed.
struct Point { x: i32, y: i32 }

fn touch(point: &mut Point) {}

fn take(point: &Point) {
    let moved = point.*; //~ error[T0035]: cannot move out of a reference or pointer
    //~ help: borrow it instead, or read only parts that copy
}

fn take_raw(point: *Point) {
    let moved = point.*; //~ error[T0035]: cannot move out of a reference or pointer
}

fn give(point: &Point) -> Point {
    return point.*; //~ error[T0035]: cannot move out of a reference or pointer
}

fn main() {
    let mut p = Point.{ x = 1, y = 2 };
    let first = &mut p;
    let second = first; //~ label: `first` is moved here
    touch(first); //~ error[T0034]: `first` is used after it was moved
    let unset: Point;
    let r = &unset; //~ error[T0039]: `unset` is used before it is set
}
