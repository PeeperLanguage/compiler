// Build:  peeper build examples/hello      (writes ./hello)
// Run:    peeper run examples/hello        (exit code 0 when every check passes)
import "hello:math";

const Greeting: cstr = c"hello from peeper\n";

fn say(text: cstr, length: i32) {
    write(stdout, text, length);
}

// Both messages are 9 bytes long.
fn check(ok: bool, pass: cstr, fail: cstr) -> i32 {
    if ok {
        say(pass, 9);
        return 0;
    }
    write(stderr, fail, 9);
    return 1;
}

fn main() -> i32 {
    say(Greeting, 18);

    let mut failures: i32 = 0;
    failures = failures + check(math::Gcd(48, 18) == 6, c"pass gcd\n", c"FAIL gcd\n");
    failures = failures + check(math::Factorial(10) == 3628800, c"pass fac\n", c"FAIL fac\n");

    // Remove the comment below to see a run-time panic (exit code 101).
    // let zero: i64 = failures;
    // let boom: i64 = 1 / zero;

    if failures == 0 {
        say(c"all good\n", 9);
    }
    return failures;
}
