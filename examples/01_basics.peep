// Functions, constants, let, if/else and return.
const Limit = 10;
const Message: i32 = Limit * 4 + 2;

fn square(x: i64) -> i64 {
    return x * x;
}

fn sign(value: i32) -> i32 {
    if value > 0 {
        return 1;
    } else if value < 0 {
        return -1;
    } else {
        return 0;
    }
}

fn main() {
    let n: i64 = square(Limit);
    let answer = Message;
    if n > 50 && sign(answer) == 1 {
        Exit(1);
    }
    Exit(0);
}
