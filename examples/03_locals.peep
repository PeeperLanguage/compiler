// Mutable locals, assignment and shadowing.
fn count(limit: i32) -> i32 {
    let mut total = 0;
    total = total + limit;
    total = total * 2;

    let limit = limit + 1;      // a let may reuse a parameter's name
    {
        let total = 5;          // an inner block may hide an outer name
        let doubled = total * 2;
    }
    let total = total + limit;  // or reuse an earlier local in the same block
    return total;
}

fn main() {
    const Start = 3;            // constants inside a body fold too
    let result = count(Start);
}
